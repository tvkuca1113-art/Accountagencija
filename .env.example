# Kopirati u .env (lokalno) ili upisati u postavke okruženja na hostingu (Vercel → Settings → Environment Variables).

# Indeksiranje: samo u produkciji postaviti na true. Na demo i pregledima ostaviti prazno (noindex + robots Disallow).
PUBLIC_ALLOW_INDEXING=

# Slanje upita (Resend, https://resend.com). Ključ se koristi samo na serveru.
RESEND_API_KEY=
# Verifikovani pošiljalac na domeni agencije, npr.: Web ACCOUNT <upit@agencija-account.com>
CONTACT_FROM=
# Primalac kojeg agencija potvrdi (više adresa odvojiti zarezom). Ne upisivati tuđi inbox za testiranje.
CONTACT_TO=
