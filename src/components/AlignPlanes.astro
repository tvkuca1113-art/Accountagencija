---
// Diskretna CSS 3D animacija: tri tanke plave plohe (papira) poravnavaju se u jednu cjelinu i zatim miruju.
// Zadano (bez JS-a, uz prefers-reduced-motion ili na slabijim uređajima) prikazuje se statično, poravnato stanje.
// Animacija se pokreće jednom, kad sekcija uđe u vidno polje; nema petlje, zvuka ni preuzimanja skrolanja.
---

<div class="planes" data-planes aria-hidden="true">
  <div class="planes__stage">
    <span class="plane plane--1"></span>
    <span class="plane plane--2"></span>
    <span class="plane plane--3"><span class="plane__rows"></span></span>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-planes]');
  if (root) {
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lowEnd = (nav.hardwareConcurrency ?? 8) <= 2 || (nav.deviceMemory ?? 8) <= 2 || nav.connection?.saveData === true;
    const belowFold = root.getBoundingClientRect().top > innerHeight;

    if (!reduced && !lowEnd && belowFold && 'IntersectionObserver' in window) {
      root.classList.add('is-scattered');
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            requestAnimationFrame(() => {
              root.classList.add('is-animating');
              root.classList.remove('is-scattered');
            });
          }
        },
        { threshold: 0.3 },
      );
      io.observe(root);
    }
  }
</script>

<style>
  .planes {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1 / 0.8;
    margin-inline: auto;
    perspective: 1400px;
  }
  .planes__stage {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(56deg) rotateZ(-38deg);
  }
  .plane {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 58%;
    aspect-ratio: 1.414 / 1; /* omjer A-formata papira */
    margin-left: -29%;
    margin-top: -20.5%;
    border-radius: 6px;
    transform-style: preserve-3d;
  }
  /* Poravnato, mirno stanje. */
  .plane--1 {
    background: var(--c-navy-700);
    transform: translateZ(0);
    box-shadow: 0 30px 40px -10px rgb(3 10 25 / 0.55);
  }
  .plane--2 {
    background: var(--c-blue-500);
    transform: translateZ(22px);
    opacity: 0.94;
  }
  .plane--3 {
    background: #f4f9fe;
    transform: translateZ(44px);
    border: 1px solid rgb(255 255 255 / 0.8);
  }
  .plane__rows {
    position: absolute;
    inset: 16% 12%;
    background: repeating-linear-gradient(
      to bottom,
      rgb(23 49 88 / 0.18) 0 2px,
      transparent 2px 16%
    );
    border-left: 3px solid var(--c-blue-500);
  }

  /* Početno, razbacano stanje (dodaje ga JS samo kad će animacija stvarno biti prikazana). */
  .planes.is-scattered .plane--1 {
    transform: translate3d(-24%, 30%, 0) rotateZ(-16deg);
  }
  .planes.is-scattered .plane--2 {
    transform: translate3d(26%, -6%, 70px) rotateZ(13deg);
  }
  .planes.is-scattered .plane--3 {
    transform: translate3d(-8%, -34%, 140px) rotateZ(-7deg);
  }

  .planes.is-animating .plane {
    transition: transform 1.3s cubic-bezier(0.2, 0.75, 0.2, 1);
  }
  .planes.is-animating .plane--2 {
    transition-delay: 0.12s;
  }
  .planes.is-animating .plane--3 {
    transition-delay: 0.24s;
  }

  @media (prefers-reduced-motion: reduce) {
    .planes .plane {
      transition: none !important;
    }
  }
</style>
