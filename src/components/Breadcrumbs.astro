---
interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Putanja">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? <a href={item.path}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    font-size: 0.875rem;
    color: var(--c-ink-muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    color: #9aaac0;
  }
  .crumbs a {
    color: var(--c-ink-muted);
  }
  .crumbs a:hover {
    color: var(--c-blue-600);
  }
</style>
