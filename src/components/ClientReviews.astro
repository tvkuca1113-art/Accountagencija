---
import { reviews, initials } from '../data/reviews.ts';
import Icon from './Icon.astro';
---
<section class="section client-voices" id="recenzije" aria-labelledby="recenzije-naslov">
  <div class="container">
    <div class="voices-head">
      <div><p class="eyebrow">Iskustva klijenata</p><h2 id="recenzije-naslov">Povjerenje koje<br /><em>traje.</em></h2></div>
      <p>Najbolje o saradnji govore ljudi<br class="desktop-break" /> koji su nam povjerili svoje poslovanje.</p>
    </div>
    <div class="voices-grid">
      {reviews.map((r,i) => <figure class:list={['voice',{'voice--short':i>1}]}>
        <figcaption>
          {r.image ? <img src={r.image} alt="" width="52" height="52" loading="lazy" /> : <span class="voice__initials" aria-hidden="true">{initials(r.name)}</span>}
          <span><strong>{r.name}</strong><small>Recenzija klijenta</small></span>
          <span class="voice__mark" aria-hidden="true">“</span>
        </figcaption>
        <blockquote><p>{r.text}</p></blockquote>
      </figure>)}
    </div>
    <p class="voices-source">Preneseno s <a href="https://www.agencija-account.com/" target="_blank" rel="noopener">izvorne stranice agencije <Icon name="arrow" size={13}/><span class="visually-hidden"> (otvara se u novom prozoru)</span></a>.</p>
  </div>
</section>
<style>
.client-voices{background:#f1f6fa}
.voices-head{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:20px;margin-bottom:36px}
.voices-head h2{font-size:clamp(2.15rem,4vw,3.4rem);line-height:1.08;letter-spacing:-.045em;margin:0}
.voices-head h2 em{font-family:Georgia,serif;color:#176caf;font-weight:400}
.voices-head>p{max-width:26rem;color:#536879;margin:0;font-size:1rem}
.voices-grid{display:grid;grid-template-columns:1fr;gap:16px}
.voice{margin:0;background:#fff;border:1px solid #dee7ee;border-radius:8px;padding:24px;display:flex;flex-direction:column}
.voice figcaption{display:flex;align-items:center;gap:13px;margin-bottom:20px}
.voice figcaption>img,.voice__initials{width:48px;height:48px;border-radius:50%;object-fit:cover;flex:none}
.voice__initials{display:grid;place-items:center;background:#e5f1fa;color:#196ba9;font-weight:750;font-size:.875rem}
.voice figcaption strong{display:block;color:#17324b;font-size:.94rem;font-weight:750}
.voice figcaption small{font-size:.6875rem;color:#617483}
.voice__mark{font-family:Georgia,serif;color:#c1ddee;font-size:4rem;line-height:1;margin-left:auto;align-self:flex-start;height:40px}
.voice blockquote{margin:0}
.voice blockquote p{margin:0;color:#374e61;line-height:1.75;font-size:.9375rem}
.voice--short{background:transparent;border-color:#d2e0ea}
.voice--short figcaption{margin-bottom:8px}
.voice--short blockquote p{font-family:Georgia,serif;font-size:1.3rem;color:#17324b}
.voices-source{margin:24px 0 0;font-size:.75rem;color:#617483}
.voices-source a{color:#466279;display:inline-flex;align-items:center;gap:5px}
.desktop-break{display:none}
@media(min-width:768px){.voices-grid{grid-template-columns:1fr 1fr;gap:22px}.voice{padding:30px 32px}.voice blockquote p{font-size:1rem}.voice--short{flex-direction:row;justify-content:space-between;align-items:center;gap:20px;padding-block:22px}.voice--short figcaption{margin:0}.voice--short .voice__mark{display:none}.voice--short blockquote p{font-size:1.125rem}.desktop-break{display:block}}
</style>
