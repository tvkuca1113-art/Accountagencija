---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, fullAddress } from '../data/site.ts';
import { services } from '../data/services.ts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <Logo variant="light" />
        <span class="visually-hidden"> — početna stranica</span>
      </a>
      <p>Računovodstvo, porezne prijave i poslovno savjetovanje u Mostaru.</p>
      <ul class="footer__social">
        {
          site.social.map((s) => (
            <li>
              <a href={s.url} rel="noopener" target="_blank">
                <Icon name={s.name === 'Instagram' ? 'instagram' : 'facebook'} size={20} />
                <span>
                  {s.name}
                  <span class="visually-hidden"> — ACCOUNT {s.handle} (otvara se u novom prozoru)</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label="Usluge">
      <h2 class="footer__title">Usluge</h2>
      <ul class="footer__links">
        {
          services.map((s) => (
            <li>
              <a href={`/${s.slug}`}>{s.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Agencija">
      <h2 class="footer__title">Agencija</h2>
      <ul class="footer__links">
        <li><a href="/o-nama">O nama</a></li>
        <li><a href="/korisni-alati">Korisni alati</a></li>
        <li><a href="/savjeti">Savjeti</a></li>
        <li><a href="/kontakt">Kontakt</a></li>
        <li><a href="/politika-privatnosti">Politika privatnosti</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="footer__title">Kontakt</h2>
      <address class="footer__contact">
        <a href={site.mapsUrl} rel="noopener" target="_blank">
          <Icon name="pin" size={18} />
          <span>{fullAddress}<span class="visually-hidden"> (Google Maps, otvara se u novom prozoru)</span></span>
        </a>
        {
          site.phones.map((p) => (
            <a href={p.href} data-track="klik_telefon">
              <Icon name="phone" size={18} />
              <span>
                <span class="visually-hidden">{p.label} telefon: </span>
                {p.display}
              </span>
            </a>
          ))
        }
        <a href={`mailto:${site.email}`}>
          <Icon name="mail" size={18} />
          <span>{site.email}</span>
        </a>
      </address>
    </div>
  </div>

  <div class="container">
    <div class="footer__bottom">
      <p>© {year} {site.legalName}, Mostar</p>
      <p>Poslovne fotografije su ilustrativne scene, ne prikaz stvarnih osoba ili prostora agencije.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-navy-950);
    color: #b7c7db;
    font-size: 0.9375rem;
    padding-top: 72px;
  }
  .footer a {
    color: #e3ecf7;
    text-decoration: none;
  }
  .footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer__grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1.1fr 0.8fr 1.3fr;
    }
  }
  .footer__logo {
    display: inline-flex;
    margin-bottom: 16px;
  }
  .footer__brand p {
    max-width: 22rem;
  }
  .footer__title {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8fa6c3;
    margin-bottom: 16px;
    font-weight: 700;
  }
  .footer__links,
  .footer__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .footer__social {
    display: flex;
    gap: 20px;
    margin-top: 20px;
  }
  .footer__social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .footer__contact {
    font-style: normal;
    display: grid;
    gap: 12px;
  }
  .footer__contact a {
    display: inline-flex;
    gap: 10px;
    align-items: flex-start;
    overflow-wrap: anywhere;
  }
  .footer__contact svg {
    margin-top: 3px;
    color: var(--c-cyan-400);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 56px;
    padding-block: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.875rem;
    color: #8fa6c3;
  }
  .footer__bottom p {
    margin: 0;
  }
</style>
