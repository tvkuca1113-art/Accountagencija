---
// Hero početne: tekst na tamnoj pozadini u boji zida sa fotografije, fotografija desno se prirodno stapa s njom
// (kratak prijelaz na lijevoj ivici umjesto tamnog sloja preko cijele slike). Brojke su čist tekstualni dokaz
// ispod poziva na akciju. Na mobitelu su naslov i dugmad iznad fotografije, a kadar 4:3 zadržava ruke i fascikl.
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { site } from '../data/site.ts';
---

<section class="hero" aria-labelledby="hero-naslov">
  <div class="container hero__content">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow">Računovodstvena agencija · Mostar</p>
      <h1 id="hero-naslov">Vi vodite posao. Mi brinemo o&nbsp;računovodstvu.</h1>
      <p class="hero__lead">
        Od poslovnih knjiga i poreznih prijava do savjeta za sljedeći korak — ACCOUNT pruža podršku vašem poslovanju.
      </p>
      <div class="hero__actions">
        <a class="btn btn--bright" href="/kontakt#upit">Zatražite ponudu <Icon name="arrow" size={18} /></a>
        <a class="btn btn--glass" href="#usluge">Pogledajte usluge</a>
      </div>
      <ul class="hero__proof">
        {
          site.stats.map((s) => (
            <li>
              <strong>{s.value}</strong> {s.label}
            </li>
          ))
        }
        <li class="hero__proof-note">
          <Icon name="doc" size={17} />
          Dokumentaciju možete dostavljati i e-mailom.
        </li>
      </ul>
    </div>
  </div>

  <div class="hero__media">
    <ResponsiveImage
      name="account-hero"
      alt="Osoba otvara tamnoplavu fasciklu sa znakom ACCOUNT na drvenom radnom stolu (ilustrativna scena)"
      sizes="(min-width: 900px) 68vw, 100vw"
      priority
      mobileArtDirection
      class="hero__photo"
    />
  </div>
</section>

<style>
  .hero {
    --hero-bg: #0d131d; /* boja zida na fotografiji — spoj bez vidljive ivice */
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--hero-bg);
    color: #c9d4e3;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-block: 36px 28px;
  }
  .hero__eyebrow {
    color: var(--c-cyan-400);
  }
  .hero__eyebrow::before {
    background: var(--c-cyan-400);
  }
  .hero h1 {
    color: #fff;
    max-width: 13ch;
  }
  .hero__lead {
    max-width: 34rem;
    margin-bottom: 28px;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: #c9d4e3;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (max-width: 899px) {
    .hero__actions .btn {
      min-height: 48px;
      padding: 10px 18px;
      font-size: 0.9375rem;
    }
    .hero__actions .btn :global(svg) {
      display: none;
    }
  }
  .hero :global(:focus-visible) {
    outline-color: #fff;
  }

  /* Brojke kao čist tekstualni dokaz ispod poziva na akciju */
  .hero__proof {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 24px;
    margin: 28px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    max-width: 34rem;
    font-size: 0.9375rem;
    color: #a9b7c9;
  }
  .hero__proof strong {
    margin-right: 4px;
    font-size: 1.25rem;
    font-weight: 800;
    color: #fff;
  }
  .hero__proof-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-basis: 100%;
  }
  .hero__proof-note :global(svg) {
    color: var(--c-cyan-400);
  }

  /* Fotografija */
  .hero__media {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 3;
    width: 100%;
    max-height: 620px;
  }
  .hero__media :global(.hero__photo) {
    position: absolute;
    inset: 0;
    display: block;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 14%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 14%);
  }
  .hero__media :global(.hero__photo img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }
  @media (min-width: 768px) and (max-width: 899px) {
    .hero__media {
      aspect-ratio: 16 / 9;
    }
  }

  /* Desktop: tekst lijevo na boji zida, fotografija desno */
  @media (min-width: 900px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: clamp(600px, 78vh, 760px);
    }
    .hero__content {
      padding-block: 96px;
    }
    .hero__text {
      max-width: 33rem;
    }
    .hero__media {
      position: absolute;
      inset: 0 0 0 auto;
      width: 68%;
      max-height: none;
      aspect-ratio: auto;
    }
    .hero__media :global(.hero__photo) {
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 26%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 26%);
    }
    .hero__media :global(.hero__photo img) {
      object-position: 62% 50%;
    }
  }
</style>
