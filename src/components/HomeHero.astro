---
// Naslovni ekran: konceptualna fotografija hercegovačkog kamena i tamnoplavog papira (bez logotipa u fotografiji).
// Desktop (≥1100 px): tipografija u tamnoj lijevoj zoni fotografije, bez tamnog sloja preko cijele slike.
// Mobitel i tablet: prvo naslov, podnaslov, pozivi i potvrđeni podaci, zatim kadar 4:3 (zid–kamen–papir).
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { site } from '../data/site.ts';
---

<section class="hero" aria-labelledby="hero-naslov">
  <div class="container hero__content">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow">Računovodstvena agencija ACCOUNT</p>
      <h1 id="hero-naslov">Računovodstvo za firme i&nbsp;obrte u&nbsp;Mostaru.</h1>
      <p class="hero__lead">Poslovne knjige, porezne obaveze i savjetovanje uz jasan dogovor i dostupnu podršku.</p>
      <div class="hero__actions">
        <a class="btn btn--bright" href="/kontakt#upit">Zatražite ponudu <Icon name="arrow" size={18} /></a>
        <a class="btn btn--glass" href="#usluge">Pregledajte usluge</a>
      </div>
      <ul class="hero__facts">
        {
          site.stats.map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))
        }
        <li class="hero__facts-place">
          <Icon name="pin" size={18} />
          <span>Lacina bb, Villa Neretva, Mostar</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="hero__media">
    <ResponsiveImage
      name="account-hero-kamen"
      alt="Tamnoplavi presavijeni papir naslonjen na hercegovački kamen (konceptualna fotografija)"
      sizes="100vw"
      priority
      mobileArtDirection
      mobileMedia="(max-width: 1099px)"
      class="hero__photo"
    />
  </div>
</section>

<style>
  .hero {
    --hero-bg: #0e1420; /* boja tamnog zida na fotografiji */
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--hero-bg);
    color: #c7d0dc;
  }
  .hero__content {
    position: relative;
    z-index: 2;
    padding-block: 40px 28px;
  }
  .hero__eyebrow {
    color: #7fcdf2;
  }
  .hero h1 {
    color: #fff;
    max-width: 12ch;
    font-size: clamp(2.375rem, 1.6rem + 3.2vw, 4rem);
  }
  .hero__lead {
    max-width: 30rem;
    margin-bottom: 28px;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: #c7d0dc;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (max-width: 480px) {
    .hero__actions .btn {
      min-height: 48px;
      padding: 10px 18px;
      font-size: 0.9375rem;
    }
    .hero__actions .btn :global(svg) {
      display: none;
    }
  }
  .hero :global(:focus-visible) {
    outline-color: #fff;
  }

  /* Potvrđeni podaci kao čist tekst */
  .hero__facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 28px;
    margin: 32px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    max-width: 34rem;
  }
  .hero__facts li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 0.9375rem;
    color: #a9b5c5;
  }
  .hero__facts strong {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
    line-height: 1;
  }
  .hero__facts-place {
    align-items: center !important;
    flex-basis: 100%;
  }
  .hero__facts-place :global(svg) {
    color: #7fcdf2;
    flex: none;
  }

  /* Fotografija — mobitel i tablet: ispod teksta */
  .hero__media {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 560px;
  }
  .hero__media :global(.hero__photo) {
    position: absolute;
    inset: 0;
    display: block;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 16%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 16%);
  }
  .hero__media :global(.hero__photo img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 60%;
  }
  @media (min-width: 768px) and (max-width: 1099px) {
    .hero__content {
      padding-block: 64px 32px;
    }
    .hero__media {
      aspect-ratio: 16 / 9;
      max-height: 540px;
    }
  }

  /* Desktop: fotografija preko cijelog heroja, tipografija na tamnom zidu */
  @media (min-width: 1100px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: clamp(620px, 80vh, 780px);
    }
    .hero__content {
      padding-block: 104px;
    }
    .hero__text {
      max-width: 34rem;
    }
    .hero__media {
      position: absolute;
      inset: 0;
      max-height: none;
      aspect-ratio: auto;
    }
    .hero__media :global(.hero__photo) {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero__media :global(.hero__photo img) {
      object-position: 100% 30%;
    }
    /* Samo lokalno: svijetli pod ispod teksta u boji zida; na širokim ekranima lijeva zona je već tamni zid. */
    .hero__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, var(--hero-bg) 0%, rgb(14 20 32 / 0.85) 30%, rgb(14 20 32 / 0) 52%),
        linear-gradient(0deg, rgb(14 20 32 / 0.9) 0%, rgb(14 20 32 / 0) 34%);
      -webkit-mask-image: linear-gradient(90deg, #000 45%, transparent 68%);
      mask-image: linear-gradient(90deg, #000 45%, transparent 68%);
      pointer-events: none;
    }
  }
</style>
