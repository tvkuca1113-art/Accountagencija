---
// Originalni znak agencije u izvornim proporcijama, uz naziv „ACCOUNT“ kao tekst.
// Znak je dekorativan (prazan alt) jer naziv odmah pored njega nosi značenje linka.
import { site } from '../data/site.ts';

interface Props {
  variant?: 'dark' | 'light';
  height?: number;
}

const { variant = 'dark', height = 44 } = Astro.props;
const logo = site.logo;
---

<span class:list={['logo', `logo--${variant}`]} style={`--logo-h: ${height}px`}>
  {
    logo && (
      <picture class="logo__mark">
        <source type="image/webp" srcset={logo.srcWebp} />
        <img src={logo.src} width={Math.round((logo.width / logo.height) * height)} height={height} alt="" decoding="async" />
      </picture>
    )
  }
  <span class="logo__text">
    <span class="logo__name">{site.name}</span>
    <span class="logo__tag">Računovodstvena agencija</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .logo__mark {
    display: block;
    flex: none;
  }
  .logo__mark img {
    display: block;
    height: var(--logo-h);
    width: auto;
  }
  .logo__text {
    display: inline-grid;
    line-height: 1;
    gap: 5px;
  }
  .logo__name {
    font-weight: 800;
    font-size: 1.375rem;
    letter-spacing: 0.2em;
    color: var(--c-navy-900);
  }
  .logo__tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-blue-600);
  }
  @media (max-width: 400px) {
    .logo {
      gap: 10px;
    }
    .logo__mark img {
      height: calc(var(--logo-h) * 0.86);
    }
    .logo__name {
      font-size: 1.1875rem;
      letter-spacing: 0.16em;
    }
    .logo__tag {
      font-size: 0.5625rem;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
  }
  .logo--light .logo__name {
    color: #fff;
  }
  .logo--light .logo__tag {
    color: var(--c-cyan-400);
  }
</style>
