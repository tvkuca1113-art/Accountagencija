---
// Originalni logo agencije u izvornim proporcijama. Dok datoteka nije dodana (site.logo = null),
// prikazuje se tekstualni naziv — bez crtanja zamjenskog znaka i bez preuzimanja znaka iz fotografija.
import { site } from '../data/site.ts';

interface Props {
  variant?: 'dark' | 'light';
  height?: number;
}

const { variant = 'dark', height = 40 } = Astro.props;
const logo = site.logo;
---

{
  logo ? (
    <img
      class="logo-img"
      src={logo.src}
      width={Math.round((logo.width / logo.height) * height)}
      height={height}
      alt={site.name}
      decoding="async"
    />
  ) : (
    <span class:list={['wordmark', `wordmark--${variant}`]}>
      <span class="wordmark__name">{site.name}</span>
      <span class="wordmark__tag">Računovodstvena agencija</span>
    </span>
  )
}

<style>
  .logo-img {
    width: auto;
  }
  .wordmark {
    display: inline-grid;
    line-height: 1;
    gap: 5px;
  }
  .wordmark__name {
    font-weight: 800;
    font-size: 1.375rem;
    letter-spacing: 0.2em;
    color: var(--c-navy-900);
  }
  .wordmark__tag {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-blue-600);
  }
  .wordmark--light .wordmark__name {
    color: #fff;
  }
  .wordmark--light .wordmark__tag {
    color: var(--c-cyan-400);
  }
</style>
