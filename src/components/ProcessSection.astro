---
// Saradnja u tri koraka: kratki koraci na jednoj liniji (desktop) ili vertikalno (mobitel).
const steps = [
  { title: 'Razgovor o potrebama', text: 'Upoznajemo vaše poslovanje, dosadašnje evidencije i ono što očekujete.' },
  { title: 'Dogovor o obimu i dostavi', text: 'Dogovaramo šta preuzimamo, rokove i način dostave dokumentacije, uključujući e-mail.' },
  { title: 'Redovna obrada i komunikacija', text: 'Knjiženje, prijave i periodični izvještaji, uz redovnu komunikaciju.' },
];
---

<section class="section surface-stone process" aria-labelledby="saradnja-naslov">
  <div class="container">
    <div class="process__head" data-reveal>
      <p class="eyebrow">Saradnja</p>
      <h2 id="saradnja-naslov">Saradnja u tri koraka</h2>
      <p>Jasan početak i dogovorena pravila, pa se vi možete baviti poslom.</p>
    </div>
    <ol class="process__steps" data-reveal>
      {
        steps.map((s, i) => (
          <li>
            <span class="process__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__head {
    max-width: 40rem;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .process__head p:last-child {
    margin: 0;
    color: var(--c-ink-muted);
  }
  .process__steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 32px;
  }
  .process__steps li {
    position: relative;
    padding-left: 64px;
  }
  /* Vertikalna linija između koraka (mobitel) */
  .process__steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 21px;
    top: 48px;
    bottom: -28px;
    width: 2px;
    background: var(--c-stone-line);
  }
  .process__num {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--c-navy-900);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .process__steps h3 {
    margin: 8px 0 6px;
    font-size: 1.1875rem;
  }
  .process__steps p {
    margin: 0;
    max-width: 22rem;
    color: var(--c-ink-muted);
  }
  @media (min-width: 900px) {
    .process__steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
    .process__steps li {
      padding: 68px 0 0;
    }
    /* Horizontalna linija na kojoj stoje brojevi */
    .process__steps li::before {
      content: '';
      position: absolute;
      left: 0;
      right: -40px;
      top: 21px;
      height: 2px;
      background: var(--c-stone-line);
    }
    .process__steps li:last-child::before {
      right: 0;
    }
    .process__steps li:not(:last-child)::after {
      display: none;
    }
    .process__num {
      z-index: 1;
      box-shadow: 0 0 0 8px var(--c-stone);
    }
  }
</style>
