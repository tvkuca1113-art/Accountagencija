---
import AlignPlanes from './AlignPlanes.astro';

const steps = [
  {
    title: 'Razgovor o potrebama',
    text: 'Upoznajemo vaše poslovanje, dosadašnje evidencije i ono što od nas očekujete.',
  },
  {
    title: 'Dogovor o obimu i dostavi dokumentacije',
    text: 'Definišemo šta preuzimamo, kako dostavljate dokumentaciju (i e-mailom) i kojom dinamikom.',
  },
  {
    title: 'Redovna obrada i komunikacija',
    text: 'Obrađujemo dokumentaciju, pripremamo prijave i izvještaje te vas pravovremeno obavještavamo.',
  },
];
---

<section class="section section--navy process" aria-labelledby="saradnja-naslov">
  <div class="container process__grid">
    <div class="process__art">
      <AlignPlanes />
    </div>
    <div>
      <p class="eyebrow">Saradnja</p>
      <h2 id="saradnja-naslov">Saradnja u tri koraka</h2>
      <p class="lead">Jasan početak i dogovorena pravila, pa se vi možete baviti poslom.</p>
      <ol class="process__steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="process__num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    overflow: hidden;
  }
  .process__grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .process__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 64px;
    }
  }
  .process__art {
    order: 2;
    max-width: 360px;
    width: 100%;
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    .process__art {
      order: 0;
      max-width: none;
    }
  }
  .process__steps {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }
  .process__steps li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 16px;
    align-items: start;
  }
  .process__num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid rgb(60 196 232 / 0.6);
    color: #fff;
    font-weight: 800;
  }
  .process__steps h3 {
    margin-bottom: 4px;
    font-size: 1.125rem;
  }
  .process__steps p {
    margin: 0;
    color: #b9cbe0;
  }
</style>
