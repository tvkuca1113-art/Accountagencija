---
// Animirani „Mjesečni pregled“: ilustracija saradnje u obliku kartice izvještaja.
// Stupci grafikona rastu, a tri koraka saradnje se redom štikliraju; na kraju iskače potvrda.
// Kartica je ilustrativna (oznaka „Primjer“, bez iznosa) i dekorativna za čitače ekrana,
// jer su isti koraci napisani u tekstu pored nje. Zadano (bez JS-a, uz prefers-reduced-motion)
// prikazuje se završno stanje; animacija se pokreće jednom, kad kartica uđe u vidno polje.
import { site } from '../data/site.ts';

const months = ['apr', 'maj', 'jun', 'jul', 'aug', 'sep'];
// Relativne visine (0–1) — ilustracija trenda, ne stvarni podaci.
const income = [0.52, 0.6, 0.56, 0.7, 0.66, 0.82];
const costs = [0.38, 0.42, 0.4, 0.44, 0.43, 0.47];
const steps = ['Dokumentacija primljena', 'Knjiženje i prijave', 'Izvještaj poslan'];
---

<div class="report-wrap" data-report aria-hidden="true">
  <div class="report">
    <div class="report__head">
      {site.logo && <img src={site.logo.src} width="22" height="28" alt="" />}
      <span class="report__title">Mjesečni pregled</span>
      <span class="report__pill">Primjer</span>
    </div>

    <div class="report__chart">
      <div class="report__bars">
        {
          months.map((_, i) => (
            <span class="report__pair" style={`--i:${i}`}>
              <span class="report__bar report__bar--in" style={`--h:${income[i]}`} />
              <span class="report__bar report__bar--out" style={`--h:${costs[i]}`} />
            </span>
          ))
        }
      </div>
      <div class="report__months">{months.map((m) => <span>{m}</span>)}</div>
      <div class="report__legend">
        <span><i class="dot dot--in"></i>Prihodi</span>
        <span><i class="dot dot--out"></i>Troškovi</span>
      </div>
    </div>

    <ol class="report__steps">
      {
        steps.map((s, i) => (
          <li style={`--i:${i}`}>
            <span class="report__tick">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12.5l4.5 4.5L19 7.5" pathLength="1" />
              </svg>
            </span>
            {s}
          </li>
        ))
      }
    </ol>
    <div class="report__progress"><span></span></div>
  </div>

  <div class="report__toast">
    <span class="report__toast-icon">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
    </span>
    <span><strong>Obaveze za mjesec evidentirane</strong><small>Sljedeći pregled za mjesec dana</small></span>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-report]')) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const belowFold = root.getBoundingClientRect().top > innerHeight * 0.85;
    if (!reduced && belowFold && 'IntersectionObserver' in window) {
      root.classList.add('is-pending');
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            requestAnimationFrame(() => {
              root.classList.add('is-playing');
              root.classList.remove('is-pending');
            });
          }
        },
        { threshold: 0.35 },
      );
      io.observe(root);
    }
  }
</script>

<style>
  .report-wrap {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin-inline: auto;
    padding-bottom: 28px;
  }
  .report {
    position: relative;
    padding: 20px 20px 18px;
    border-radius: 20px;
    background: #fff;
    color: var(--c-ink);
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.6),
      0 0 0 1px rgb(255 255 255 / 0.08);
  }
  @media (min-width: 900px) {
    .report {
      transform: perspective(1400px) rotateY(10deg) rotateX(4deg);
      transform-origin: left center;
    }
  }
  .report__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .report__head img {
    width: 22px;
    height: auto;
  }
  .report__title {
    font-weight: 800;
    color: var(--c-navy-900);
  }
  .report__pill {
    margin-left: auto;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--c-blue-100);
    color: var(--c-blue-700);
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* Grafikon */
  .report__chart {
    padding: 14px 14px 10px;
    border-radius: 14px;
    background: var(--c-bg);
  }
  .report__bars {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: end;
    gap: 10px;
    height: 120px;
    background: repeating-linear-gradient(180deg, transparent 0 29px, rgb(15 35 64 / 0.07) 29px 30px);
  }
  .report__pair {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 3px;
    height: 100%;
  }
  .report__bar {
    width: 42%;
    height: calc(var(--h) * 100%);
    border-radius: 4px 4px 1px 1px;
    transform-origin: bottom;
  }
  .report__bar--in {
    background: linear-gradient(180deg, #33b6f2, var(--c-blue-500));
  }
  .report__bar--out {
    background: #b6c7dc;
  }
  .report__months {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    margin-top: 6px;
    text-align: center;
    font-size: 0.6875rem;
    color: var(--c-ink-muted);
  }
  .report__legend {
    display: flex;
    gap: 14px;
    margin-top: 8px;
    font-size: 0.75rem;
    color: var(--c-ink-muted);
  }
  .report__legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }
  .dot--in {
    background: var(--c-blue-500);
  }
  .dot--out {
    background: #b6c7dc;
  }

  /* Koraci */
  .report__steps {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--c-navy-900);
  }
  .report__steps li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .report__tick {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--c-blue-500);
    border: 2px solid var(--c-blue-500);
    color: #fff;
  }
  .report__tick path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .report__progress {
    height: 4px;
    margin-top: 16px;
    border-radius: 4px;
    background: var(--c-blue-100);
    overflow: hidden;
  }
  .report__progress span {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--c-blue-logo), var(--c-blue-500));
    transform-origin: left;
  }

  /* Potvrda koja iskače preko kartice */
  .report__toast {
    position: absolute;
    right: -8px;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--c-navy-800);
    border: 1px solid rgb(255 255 255 / 0.14);
    color: #fff;
    box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.7);
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  .report__toast strong {
    display: block;
    font-weight: 700;
  }
  .report__toast small {
    color: #a9bdd6;
    font-size: 0.75rem;
  }
  .report__toast-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #17784a;
  }
  @media (min-width: 900px) {
    .report__toast {
      right: -28px;
    }
  }

  /* Početno stanje prije animacije (samo kad je animacija dozvoljena) */
  .is-pending .report {
    opacity: 0;
    translate: 0 24px;
  }
  .is-pending .report__bar {
    transform: scaleY(0);
  }
  .is-pending .report__tick {
    background: #fff;
    border-color: #c7d4e4;
    color: transparent;
  }
  .is-pending .report__tick path {
    stroke-dashoffset: 1;
  }
  .is-pending .report__steps li {
    color: var(--c-ink-muted);
  }
  .is-pending .report__progress span {
    transform: scaleX(0);
  }
  .is-pending .report__toast {
    opacity: 0;
    transform: translateY(12px) scale(0.96);
  }

  /* Tok animacije */
  .is-playing .report {
    transition:
      opacity 0.6s ease,
      translate 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .is-playing .report__bar {
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: calc(0.35s + var(--i) * 0.08s);
  }
  .is-playing .report__pair .report__bar--out {
    transition-delay: calc(0.45s + var(--i) * 0.08s);
  }
  .is-playing .report__tick {
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease;
    transition-delay: calc(1.1s + var(--i) * 0.45s);
  }
  .is-playing .report__tick path {
    transition: stroke-dashoffset 0.35s ease;
    transition-delay: calc(1.15s + var(--i) * 0.45s);
  }
  .is-playing .report__steps li {
    transition: color 0.3s ease;
    transition-delay: calc(1.1s + var(--i) * 0.45s);
  }
  .is-playing .report__progress span {
    transition: transform 1.4s cubic-bezier(0.4, 0, 0.2, 1) 1.05s;
  }
  .is-playing .report__toast {
    transition:
      opacity 0.4s ease 2.6s,
      transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.3) 2.6s;
  }
</style>
