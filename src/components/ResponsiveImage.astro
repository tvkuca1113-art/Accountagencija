---
// <picture> s AVIF/WebP varijantama iz scripts/optimize-images.mjs, eksplicitnim dimenzijama (bez CLS-a)
// i odgođenim učitavanjem osim kad je slika prioritetna (hero).
export type ImageName = 'account-hero-kamen' | 'mostar-stari-most';

interface Props {
  name: ImageName;
  alt: string;
  sizes: string;
  priority?: boolean;
  class?: string;
  /** Za hero: poseban kadar (`<name>-mobile`) za uže ekrane. */
  mobileArtDirection?: boolean;
  mobileMedia?: string;
  objectPosition?: string;
}

const variants: Record<string, { widths: number[]; width: number; height: number }> = {
  'account-hero-kamen': { widths: [640, 960, 1280, 1672], width: 1672, height: 941 },
  'account-hero-kamen-mobile': { widths: [480, 800, 972], width: 972, height: 729 },
  'mostar-stari-most': { widths: [480, 800, 1200], width: 1200, height: 800 },
};

const {
  name,
  alt,
  sizes,
  priority = false,
  class: className,
  mobileArtDirection = false,
  mobileMedia = '(max-width: 767px)',
  objectPosition,
} = Astro.props;
const v = variants[name];
const srcset = (base: string, widths: number[], ext: string) =>
  widths.map((w) => `/images/${base}-${w}.${ext} ${w}w`).join(', ');
const fallback = `/images/${name}-${v.widths.at(-2) ?? v.widths[0]}.webp`;
const mobile = variants[`${name}-mobile`];
---

<picture class={className}>
  {
    mobileArtDirection && mobile && (
      <>
        <source
          media={mobileMedia}
          type="image/avif"
          srcset={srcset(`${name}-mobile`, mobile.widths, 'avif')}
          sizes="100vw"
          width={mobile.width}
          height={mobile.height}
        />
        <source
          media={mobileMedia}
          type="image/webp"
          srcset={srcset(`${name}-mobile`, mobile.widths, 'webp')}
          sizes="100vw"
          width={mobile.width}
          height={mobile.height}
        />
      </>
    )
  }
  <source type="image/avif" srcset={srcset(name, v.widths, 'avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset(name, v.widths, 'webp')} sizes={sizes} />
  <img
    src={fallback}
    alt={alt}
    width={v.width}
    height={v.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
    style={objectPosition ? `object-position: ${objectPosition}` : undefined}
  />
</picture>
