---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site.ts';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
  mobileBar?: boolean;
}

const { title, description, ogImage = '/images/og-account.jpg', ogType = 'website', jsonLd = [], noindex = false, mobileBar = true } =
  Astro.props;

// Canonical bez parametara (UTM, fbclid, ?usluga=…) i bez završne kose crte.
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(pathname, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

// Demo i pregledne verzije se ne indeksiraju. Za produkciju postaviti PUBLIC_ALLOW_INDEXING=true.
const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === 'true';
const robots = !allowIndexing || noindex ? 'noindex, nofollow' : 'index, follow';
---

<!doctype html>
<html lang="bs-BA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    {site.verification.map((v) => <meta name={v.name} content={v.content} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="bs_BA" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0f2340" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin-ext-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#sadrzaj">Preskoči na sadržaj</a>
    <Header />
    <main id="sadrzaj" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {mobileBar && <MobileBar />}

    <script>
      import { initClickTracking } from '../scripts/analytics.ts';
      initClickTracking();
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
