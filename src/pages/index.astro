---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ServiceGuide from '../components/ServiceGuide.astro';
import ArticleCards from '../components/ArticleCards.astro';
import FaqList from '../components/FaqList.astro';
import { services, audiences } from '../data/services.ts';
import { generalFaq } from '../data/faq.ts';
import { site, fullAddress } from '../data/site.ts';
import { organizationSchema } from '../lib/schema.ts';

const [featured, ...rest] = services;
---

<Base
  title="Računovodstvo Mostar | Agencija ACCOUNT"
  description="Računovodstvo, porezne prijave i poslovno savjetovanje u Mostaru. Upoznajte usluge agencije ACCOUNT i zatražite ponudu za svoje poslovanje."
  jsonLd={[organizationSchema()]}
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-naslov">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Računovodstvena agencija · Mostar</p>
        <h1 id="hero-naslov">Vi vodite posao. Mi brinemo o&nbsp;računovodstvu.</h1>
        <p class="lead">
          Od poslovnih knjiga i poreznih prijava do savjeta za sljedeći korak — ACCOUNT pruža podršku vašem poslovanju.
        </p>
        <div class="hero__actions">
          <a class="btn" href="/kontakt#upit">Zatražite ponudu <Icon name="arrow" size={18} /></a>
          <a class="btn btn--ghost" href="#usluge">Pogledajte usluge</a>
        </div>
        <p class="hero__note">
          <Icon name="doc" size={18} />
          Dokumentaciju možete dostavljati i e-mailom.
        </p>
      </div>
      <div class="hero__media">
        <ResponsiveImage
          name="account-hero"
          alt="Radni sto s laptopom i tamnoplavim fasciklom s logotipom ACCOUNT, uz prozor s pogledom na Stari most u Mostaru"
          sizes="(min-width: 1240px) 640px, (min-width: 900px) 52vw, 100vw"
          priority
          mobileArtDirection
          class="media hero__img"
        />
        <dl class="hero__stats">
          {
            site.stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- Kome pomažemo -->
  <section class="section section--tight audiences" aria-labelledby="kome-naslov">
    <div class="container">
      <h2 id="kome-naslov" class="audiences__title">Kome pomažemo</h2>
      <ul class="audiences__list">
        {
          audiences.map((a) => (
            <li>
              <a href={`/${a.slug}`}>
                <span class="audiences__name">{a.title}</span>
                <span class="audiences__text">{a.text}</span>
                <Icon name="arrow" size={20} class="audiences__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Usluge -->
  <section class="section section--tint" id="usluge" aria-labelledby="usluge-naslov">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Usluge</p>
        <h2 id="usluge-naslov">Podrška za svaku fazu poslovanja</h2>
        <p class="lead">Od prvog koraka i registracije do urednih knjiga, izvještaja i planiranja rasta.</p>
      </div>

      <article class="svc-featured">
        <ResponsiveImage
          name={featured.image}
          alt={featured.imageAlt}
          sizes="(min-width: 1024px) 600px, 100vw"
          class="media svc-featured__media"
        />
        <div class="svc-featured__body">
          <h3><a href={`/${featured.slug}`}>{featured.title}</a></h3>
          <p class="svc-featured__benefit">{featured.benefit}</p>
          <ul class="checklist">
            {featured.scope.slice(0, 4).map((item) => <li>{item}</li>)}
          </ul>
          <a class="link-arrow" href={`/${featured.slug}`}>
            Više o usluzi<span class="visually-hidden">: {featured.title}</span> <Icon name="arrow" size={18} />
          </a>
        </div>
      </article>

      <ul class="svc-grid">
        {
          rest.map((s) => (
            <li class="svc-card">
              <ResponsiveImage name={s.image} alt={s.imageAlt} sizes="(min-width: 1024px) 580px, (min-width: 640px) 50vw, 100vw" class="media svc-card__media" />
              <div class="svc-card__body">
                <h3>
                  <a href={`/${s.slug}`}>{s.title}</a>
                </h3>
                <p>{s.benefit}</p>
                <span class="link-arrow" aria-hidden="true">
                  Više o usluzi <Icon name="arrow" size={18} />
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ProcessSection />

  <!-- Vodič -->
  <section class="section section--tint" aria-labelledby="vodic-naslov">
    <div class="container guide-wrap">
      <div class="guide-wrap__intro">
        <p class="eyebrow">Vodič</p>
        <h2 id="vodic-naslov">Koja vam usluga treba?</h2>
        <p class="lead">Odgovorite na tri kratka pitanja i dobit ćete preporuku te spisak informacija za prvi razgovor.</p>
        <p>Kontakt podaci nisu potrebni da biste vidjeli rezultat.</p>
        <a class="link-arrow" href="/korisni-alati">Svi korisni alati <Icon name="arrow" size={18} /></a>
      </div>
      <ServiceGuide id="vodic-pocetna" />
    </div>
  </section>

  <!-- O agenciji -->
  <section class="section about" aria-labelledby="o-nama-naslov">
    <div class="container about__grid">
      <div>
        <p class="eyebrow">O agenciji</p>
        <h2 id="o-nama-naslov">Lokalna stručnost, jasan govor</h2>
        <p class="lead">
          ACCOUNT je računovodstvena agencija iz Mostara. Firmama, obrtima, udruženjima i inostranim preduzećima pomažemo da
          imaju uredne evidencije i jasan pregled poslovanja.
        </p>
        <p>
          Pored računovodstva i poreznih prijava, savjetujemo o poslovnim i poreznim pitanjima, pomažemo pri registraciji i
          pripremamo poslovne projekte.
        </p>
        <a class="link-arrow" href="/o-nama">Više o nama <Icon name="arrow" size={18} /></a>
      </div>
      <dl class="about__stats">
        {
          site.stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
        <div>
          <dt>uslužnih oblasti na jednom mjestu</dt>
          <dd>5</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Savjeti -->
  <section class="section section--tint" aria-labelledby="savjeti-naslov">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">Savjeti</p>
          <h2 id="savjeti-naslov">Korisno za vaše poslovanje</h2>
        </div>
        <a class="link-arrow" href="/savjeti">Svi savjeti <Icon name="arrow" size={18} /></a>
      </div>
      <ArticleCards />
    </div>
  </section>

  <!-- FAQ i kontakt -->
  <section class="section" aria-labelledby="faq-naslov">
    <div class="container faq-contact">
      <div>
        <p class="eyebrow">Česta pitanja</p>
        <h2 id="faq-naslov">Prije prvog razgovora</h2>
        <FaqList items={generalFaq.slice(0, 4)} />
      </div>
      <aside class="contact-card" aria-labelledby="kontakt-kartica-naslov">
        <h2 id="kontakt-kartica-naslov">Kontaktirajte nas</h2>
        <p>Pošaljite upit ili nas pozovite. Ponudu pripremamo prema obimu i potrebama vašeg poslovanja.</p>
        <ul class="contact-card__list">
          {
            site.phones.map((p) => (
              <li>
                <Icon name="phone" size={18} />
                <a href={p.href} data-track="klik_telefon">{p.display}</a>
                <span class="contact-card__label">{p.label}</span>
              </li>
            ))
          }
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Icon name="pin" size={18} />
            <a href={site.mapsUrl} rel="noopener" target="_blank">
              {fullAddress}<span class="visually-hidden"> (Google Maps, otvara se u novom prozoru)</span>
            </a>
          </li>
        </ul>
        <a class="btn" href="/kontakt#upit">Zatražite ponudu <Icon name="arrow" size={18} /></a>
      </aside>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(32px, 4vw, 72px) clamp(48px, 5vw, 96px);
    background: linear-gradient(180deg, var(--c-bg) 0%, #fff 100%);
  }
  .hero__grid {
    display: grid;
    gap: 36px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr 1.05fr;
      gap: 56px;
    }
  }
  .hero__text h1 {
    max-width: 13ch;
  }
  .hero__text .lead {
    margin-bottom: 28px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__note {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 22px 0 0;
    font-size: var(--fs-small);
    color: var(--c-ink-muted);
  }
  .hero__note svg {
    color: var(--c-blue-600);
  }
  .hero__media {
    position: relative;
  }
  :global(.media.hero__img) {
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow);
  }
  @media (min-width: 768px) {
    :global(.media.hero__img) {
      aspect-ratio: 16 / 10;
    }
  }
  :global(.media.hero__img) :global(img) {
    object-position: 100% 50%;
  }
  .hero__stats {
    display: flex;
    gap: 28px;
    margin: 0;
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 14px 20px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.95);
    box-shadow: var(--shadow);
  }
  .hero__stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .hero__stats dd {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--c-navy-900);
    line-height: 1.1;
  }
  .hero__stats dt {
    font-size: 0.8125rem;
    color: var(--c-ink-muted);
  }
  @media (min-width: 900px) {
    .hero__stats {
      left: -28px;
      bottom: 28px;
    }
  }

  /* Kome pomažemo */
  .audiences {
    padding-top: 0;
  }
  .audiences__title {
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
    margin-bottom: 20px;
    font-weight: 700;
  }
  .audiences__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .audiences__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .audiences__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .audiences__list a {
    position: relative;
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 20px 52px 20px 20px;
    border-radius: var(--radius);
    border: 1px solid var(--c-line);
    text-decoration: none;
    color: var(--c-ink);
    transition:
      border-color 0.18s ease,
      background-color 0.18s ease;
  }
  .audiences__list a:hover {
    border-color: var(--c-blue-600);
    background: var(--c-bg);
  }
  .audiences__name {
    font-weight: 750;
    color: var(--c-navy-900);
    font-size: 1.0625rem;
  }
  .audiences__text {
    font-size: 0.9375rem;
    color: var(--c-ink-muted);
    line-height: 1.5;
  }
  .audiences__list :global(.audiences__arrow) {
    position: absolute;
    right: 18px;
    top: 22px;
    color: var(--c-blue-600);
    transition: transform 0.18s ease;
  }
  .audiences__list a:hover :global(.audiences__arrow) {
    transform: translateX(3px);
  }

  /* Usluge */
  .svc-featured {
    display: grid;
    background: #fff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--c-line);
    overflow: hidden;
    margin-bottom: 24px;
  }
  @media (min-width: 1024px) {
    .svc-featured {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  :global(.media.svc-featured__media) {
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  .svc-featured__body {
    padding: clamp(24px, 3.5vw, 48px);
    align-self: center;
  }
  .svc-featured h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }
  .svc-featured h3 a,
  .svc-card h3 a {
    color: var(--c-navy-900);
    text-decoration: none;
  }
  .svc-featured h3 a:hover,
  .svc-card h3 a:hover {
    color: var(--c-blue-600);
  }
  .svc-featured__benefit {
    font-size: 1.125rem;
    color: var(--c-ink-muted);
  }
  .svc-featured .checklist {
    margin: 24px 0 28px;
  }
  .svc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .svc-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    background: #fff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--c-line);
    overflow: hidden;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .svc-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  :global(.media.svc-card__media) {
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  @media (min-width: 1024px) {
    :global(.media.svc-card__media) {
      aspect-ratio: 16 / 10;
    }
  }
  .svc-card__body {
    padding: 24px 26px 28px;
    display: flex;
    flex-direction: column;
  }
  .svc-card__body p {
    color: var(--c-ink-muted);
  }
  .svc-card__body .link-arrow {
    margin-top: auto;
    color: var(--c-blue-600);
  }
  .svc-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .svc-card h3 a:focus-visible {
    outline: none;
  }
  .svc-card:has(a:focus-visible) {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }

  /* Vodič */
  .guide-wrap {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .guide-wrap {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
    }
    .guide-wrap__intro {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }

  /* O agenciji */
  .about__grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 72px;
    }
  }
  .about__stats {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--c-line);
  }
  .about__stats div {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: center;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--c-line);
  }
  .about__stats dd {
    margin: 0;
    min-width: 4.5ch;
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--c-blue-600);
    line-height: 1;
  }
  .about__stats dt {
    font-weight: 650;
    color: var(--c-navy-900);
  }

  /* Savjeti */
  .section-head--row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    max-width: none;
  }
  .section-head--row h2 {
    margin: 0;
  }

  /* FAQ i kontakt */
  .faq-contact {
    display: grid;
    gap: 48px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .faq-contact {
      grid-template-columns: 1.4fr 1fr;
      gap: 72px;
    }
  }
  .contact-card {
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
  }
  .contact-card h2 {
    font-size: 1.5rem;
  }
  .contact-card__list {
    list-style: none;
    margin: 24px 0 28px;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .contact-card__list li {
    display: grid;
    grid-template-columns: 18px 1fr;
    column-gap: 12px;
    align-items: start;
    overflow-wrap: anywhere;
  }
  .contact-card__list svg {
    margin-top: 4px;
    color: var(--c-blue-600);
    flex: none;
  }
  .contact-card__list a {
    font-weight: 650;
    color: var(--c-navy-900);
  }
  .contact-card__label {
    grid-column: 2;
    font-size: 0.85rem;
    color: var(--c-ink-muted);
  }
</style>
