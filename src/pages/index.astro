---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HomeHero from '../components/HomeHero.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ServiceGuide from '../components/ServiceGuide.astro';
import ArticleCards from '../components/ArticleCards.astro';
import FaqList from '../components/FaqList.astro';
import { services, audiences } from '../data/services.ts';
import { generalFaq } from '../data/faq.ts';
import { site, fullAddress } from '../data/site.ts';
import { organizationSchema } from '../lib/schema.ts';

const [featured, ...rest] = services;

// Traka povjerenja: samo potvrđene tvrdnje agencije i činjenice s postojećeg weba.
const trust = [
  { icon: 'shield', title: 'Ovlašteno zastupanje', text: 'stranih poreznih obveznika' },
  { icon: 'pin', title: 'Lokalno, u Mostaru', text: 'Lacina bb, Villa Neretva' },
  { icon: 'mail', title: 'Dokumentacija i e-mailom', text: 'digitalna dostava dokumentacije' },
  { icon: 'handshake', title: 'Individualna ponuda', text: 'prema obimu i složenosti posla' },
] as const;

// Visine stubića u mini grafikonu kalkulatora (ilustracija, bez podataka).
const miniBars = [0.35, 0.5, 0.42, 0.68, 0.6, 0.82, 0.74];
---

<Base
  title="Računovodstvo Mostar | Agencija ACCOUNT"
  description="Računovodstvo, porezne prijave i poslovno savjetovanje u Mostaru. Upoznajte usluge agencije ACCOUNT i zatražite ponudu za svoje poslovanje."
  jsonLd={[organizationSchema()]}
>
  <HomeHero />

  <!-- Traka povjerenja -->
  <section class="trust" aria-label="Zašto nam klijenti vjeruju">
    <div class="container">
      <ul class="trust__list">
        {
          trust.map((t) => (
            <li>
              <span class="trust__icon"><Icon name={t.icon} size={22} /></span>
              <span>
                <strong>{t.title}</strong>
                <span>{t.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Kome pomažemo -->
  <section class="audiences" aria-labelledby="kome-naslov">
    <div class="container">
      <h2 id="kome-naslov" class="audiences__title">Kome pomažemo</h2>
      <ul class="audiences__list">
        {
          audiences.map((a) => (
            <li>
              <a href={`/${a.slug}`}>
                <span class="audiences__name">{a.title}</span>
                <span class="audiences__text">{a.text}</span>
                <Icon name="arrow" size={20} class="audiences__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Usluge -->
  <section class="section section--tint section--pattern" id="usluge" aria-labelledby="usluge-naslov">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Usluge</p>
        <h2 id="usluge-naslov">Podrška za svaku fazu poslovanja</h2>
        <p class="lead">Od prvog koraka i registracije do urednih knjiga, izvještaja i planiranja rasta.</p>
      </div>

      <article class="svc-featured" data-reveal>
        <ResponsiveImage
          name={featured.image}
          alt={featured.imageAlt}
          sizes="(min-width: 1024px) 600px, 100vw"
          class="media svc-featured__media"
        />
        <div class="svc-featured__body">
          <span class="svc-featured__index" aria-hidden="true">01</span>
          <h3><a href={`/${featured.slug}`}>{featured.title}</a></h3>
          <p class="svc-featured__benefit">{featured.benefit}</p>
          <ul class="checklist">
            {featured.scope.slice(0, 4).map((item) => <li>{item}</li>)}
          </ul>
          <a class="link-arrow" href={`/${featured.slug}`}>
            Više o usluzi<span class="visually-hidden">: {featured.title}</span> <Icon name="arrow" size={18} />
          </a>
        </div>
      </article>

      <ul class="svc-grid">
        {
          rest.map((s, i) => (
            <li class="svc-card" data-reveal style={`--reveal-delay: ${(i % 2) * 0.08}s`}>
              <span class="svc-card__index" aria-hidden="true">{String(i + 2).padStart(2, '0')}</span>
              <ResponsiveImage name={s.image} alt={s.imageAlt} sizes="(min-width: 1024px) 580px, (min-width: 640px) 50vw, 100vw" class="media svc-card__media" />
              <div class="svc-card__body">
                <h3>
                  <a href={`/${s.slug}`}>{s.title}</a>
                </h3>
                <p>{s.benefit}</p>
                <span class="link-arrow" aria-hidden="true">
                  Više o usluzi <Icon name="arrow" size={18} />
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ProcessSection />

  <!-- Vodič -->
  <section class="section section--tint" aria-labelledby="vodic-naslov">
    <div class="container guide-wrap">
      <div class="guide-wrap__intro" data-reveal>
        <p class="eyebrow">Vodič</p>
        <h2 id="vodic-naslov">Koja vam usluga treba?</h2>
        <p class="lead">Odgovorite na tri kratka pitanja i dobit ćete preporuku te spisak informacija za prvi razgovor.</p>
        <p>Kontakt podaci nisu potrebni da biste vidjeli rezultat.</p>
        <a class="link-arrow" href="/korisni-alati">Svi korisni alati <Icon name="arrow" size={18} /></a>
      </div>
      <ServiceGuide id="vodic-pocetna" />
    </div>
  </section>

  <!-- Zašto ACCOUNT -->
  <section class="section bento-section" aria-labelledby="zasto-naslov">
    <div class="container">
      <div class="bento">
        <article class="bento__card bento__card--about" data-reveal>
          <p class="eyebrow">Zašto ACCOUNT</p>
          <h2 id="zasto-naslov">Lokalna stručnost, jasan govor</h2>
          <p>
            ACCOUNT je računovodstvena agencija iz Mostara. Firmama, obrtima, udruženjima i inostranim preduzećima pomažemo
            da imaju uredne evidencije i jasan pregled poslovanja, uz ovlašteno zastupanje stranih poreznih obveznika.
          </p>
          <dl class="bento__stats">
            {
              site.stats.map((s) => (
                <div>
                  <dt>{s.label}</dt>
                  <dd data-count={parseInt(s.value, 10)} data-suffix={s.value.replace(/^\d+/, '')}>
                    {s.value}
                  </dd>
                </div>
              ))
            }
            <div>
              <dt>uslužnih oblasti</dt>
              <dd data-count="5">5</dd>
            </div>
          </dl>
          <a class="link-arrow bento__link-light" href="/o-nama">Više o nama <Icon name="arrow" size={18} /></a>
        </article>

        <a class="bento__card bento__card--calc" href="/korisni-alati#kalkulator" data-reveal style="--reveal-delay: 0.08s">
          <span class="bento__tag">Kalkulator</span>
          <h3>Koliki promet vam treba da pokrijete troškove?</h3>
          <p>Unesite fiksne i varijabilne troškove i odmah vidite prag pokrića. Izračun ostaje u vašem pregledniku.</p>
          <span class="mini-chart" aria-hidden="true">
            <span class="mini-chart__line"><span>prag pokrića</span></span>
            {miniBars.map((h, i) => <i style={`--h:${h}; --i:${i}`} class:list={{ 'is-above': h > 0.55 }} />)}
          </span>
          <span class="link-arrow">Isprobajte kalkulator <Icon name="arrow" size={18} /></span>
        </a>

        <a class="bento__card bento__card--config" href="/korisni-alati#konfigurator" data-reveal style="--reveal-delay: 0.16s">
          <span class="bento__icon"><Icon name="sliders" size={24} /></span>
          <h3>Pripremite upit</h3>
          <p>Označite vrstu i obim poslovanja, a sažetak pošaljite uz upit.</p>
          <span class="link-arrow">Konfigurator upita <Icon name="arrow" size={18} /></span>
        </a>

        <a class="bento__card bento__card--call" href={site.phones[0].href} data-track="klik_telefon" data-reveal style="--reveal-delay: 0.24s">
          <span class="bento__icon"><Icon name="phone" size={24} /></span>
          <h3>Radije razgovor?</h3>
          <span class="bento__phone">{site.phones[0].display}</span>
          <span class="bento__sub">ili fiksni {site.phones[1].display}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Savjeti -->
  <section class="section section--tint" aria-labelledby="savjeti-naslov">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">Savjeti</p>
          <h2 id="savjeti-naslov">Korisno za vaše poslovanje</h2>
        </div>
        <a class="link-arrow" href="/savjeti">Svi savjeti <Icon name="arrow" size={18} /></a>
      </div>
      <ArticleCards />
    </div>
  </section>

  <!-- FAQ i kontakt -->
  <section class="section" aria-labelledby="faq-naslov">
    <div class="container faq-contact">
      <div data-reveal>
        <p class="eyebrow">Česta pitanja</p>
        <h2 id="faq-naslov">Prije prvog razgovora</h2>
        <FaqList items={generalFaq.slice(0, 4)} />
      </div>
      <aside class="contact-card" aria-labelledby="kontakt-kartica-naslov" data-reveal>
        <h2 id="kontakt-kartica-naslov">Kontaktirajte nas</h2>
        <p>Pošaljite upit ili nas pozovite. Ponudu pripremamo prema obimu i potrebama vašeg poslovanja.</p>
        <ul class="contact-card__list">
          {
            site.phones.map((p) => (
              <li>
                <Icon name="phone" size={18} />
                <a href={p.href} data-track="klik_telefon">{p.display}</a>
                <span class="contact-card__label">{p.label}</span>
              </li>
            ))
          }
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Icon name="pin" size={18} />
            <a href={site.mapsUrl} rel="noopener" target="_blank">
              {fullAddress}<span class="visually-hidden"> (Google Maps, otvara se u novom prozoru)</span>
            </a>
          </li>
        </ul>
        <a class="btn" href="/kontakt#upit">Zatražite ponudu <Icon name="arrow" size={18} /></a>
      </aside>
    </div>
  </section>
</Base>

<style>
  /* Traka povjerenja: na desktopu panel koji pluta preko donjeg ruba heroja */
  .trust {
    position: relative;
    z-index: 3;
    padding-top: 20px;
  }
  .trust__list {
    list-style: none;
    margin: 0;
    padding: 18px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 14px;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--c-line);
    box-shadow: 0 20px 50px -24px rgb(10 24 46 / 0.35);
  }
  .trust__list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--c-ink-muted);
  }
  .trust__list strong {
    display: block;
    color: var(--c-navy-900);
    font-size: 0.9375rem;
  }
  .trust__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--c-blue-100);
    color: var(--c-blue-600);
  }
  @media (max-width: 479px) {
    .trust__list {
      grid-template-columns: 1fr;
    }
  }
  @media (min-width: 900px) {
    .trust {
      margin-top: -64px;
      padding-top: 0;
    }
    .trust__list {
      padding: 24px 28px;
      gap: 20px 24px;
      border: 0;
      box-shadow: 0 24px 60px -20px rgb(10 24 46 / 0.35), 0 2px 8px rgb(10 24 46 / 0.06);
    }
  }
  @media (min-width: 1180px) {
    .trust__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .trust__list li + li {
      padding-left: 24px;
      border-left: 1px solid var(--c-line);
    }
  }

  /* Kome pomažemo */
  .audiences {
    padding-block: clamp(40px, 5vw, 72px) 8px;
  }
  .audiences__title {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    margin-bottom: 20px;
  }
  .audiences__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  @media (min-width: 480px) {
    .audiences__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 639px) {
    .audiences__list a {
      gap: 2px;
      padding: 14px 44px 14px 16px;
    }
    .audiences__list :global(.audiences__arrow) {
      top: 50%;
      margin-top: -10px;
    }
  }
  @media (min-width: 1024px) {
    .audiences__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .audiences__list a {
    position: relative;
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 20px 52px 20px 20px;
    border-radius: var(--radius);
    border: 1px solid var(--c-line);
    text-decoration: none;
    color: var(--c-ink);
    transition:
      border-color 0.18s ease,
      background-color 0.18s ease;
  }
  .audiences__list a:hover {
    border-color: var(--c-blue-600);
    background: var(--c-bg);
  }
  .audiences__name {
    font-weight: 750;
    color: var(--c-navy-900);
    font-size: 1.0625rem;
  }
  .audiences__text {
    font-size: 0.9375rem;
    color: var(--c-ink-muted);
    line-height: 1.5;
  }
  .audiences__list :global(.audiences__arrow) {
    position: absolute;
    right: 18px;
    top: 22px;
    color: var(--c-blue-600);
    transition: transform 0.18s ease;
  }
  .audiences__list a:hover :global(.audiences__arrow) {
    transform: translateX(3px);
  }

  /* Usluge */
  .svc-featured {
    display: grid;
    background: #fff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--c-line);
    overflow: hidden;
    margin-bottom: 24px;
  }
  @media (min-width: 1024px) {
    .svc-featured {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  :global(.media.svc-featured__media) {
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  .svc-featured__body {
    padding: clamp(24px, 3.5vw, 48px);
    align-self: center;
  }
  .svc-featured h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }
  .svc-featured h3 a,
  .svc-card h3 a {
    color: var(--c-navy-900);
    text-decoration: none;
  }
  .svc-featured h3 a:hover,
  .svc-card h3 a:hover {
    color: var(--c-blue-600);
  }
  .svc-featured__benefit {
    font-size: 1.125rem;
    color: var(--c-ink-muted);
  }
  .svc-featured .checklist {
    margin: 24px 0 28px;
  }
  .svc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .svc-card__index,
  .svc-featured__index {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--c-blue-600);
  }
  .svc-featured__index {
    display: block;
    margin-bottom: 12px;
  }
  .svc-card__index {
    position: absolute;
    z-index: 1;
    top: 16px;
    left: 16px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    box-shadow: var(--shadow-sm);
  }
  /* Blago uvećanje fotografije pri prelasku mišem */
  .svc-card :global(img),
  .svc-featured :global(img) {
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .svc-card:hover :global(img),
  .svc-featured:hover :global(img) {
    transform: scale(1.04);
  }
  .svc-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    background: #fff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--c-line);
    overflow: hidden;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .svc-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  :global(.media.svc-card__media) {
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  @media (min-width: 1024px) {
    :global(.media.svc-card__media) {
      aspect-ratio: 16 / 10;
    }
  }
  .svc-card__body {
    padding: 24px 26px 28px;
    display: flex;
    flex-direction: column;
  }
  .svc-card__body p {
    color: var(--c-ink-muted);
  }
  .svc-card__body .link-arrow {
    margin-top: auto;
    color: var(--c-blue-600);
  }
  .svc-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .svc-card h3 a:focus-visible {
    outline: none;
  }
  .svc-card:has(a:focus-visible) {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }

  /* Vodič */
  .guide-wrap {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .guide-wrap {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
    }
    .guide-wrap__intro {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }

  /* Zašto ACCOUNT: bento mreža */
  .bento {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bento__card--about {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: 1.25fr 1fr 1fr;
      grid-template-rows: auto auto;
    }
    .bento__card--about {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .bento__card--calc {
      grid-column: 2 / span 2;
    }
  }
  .bento__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    color: var(--c-ink);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }
  a.bento__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--c-blue-200);
    color: var(--c-ink);
  }
  .bento__card h3 {
    margin: 0;
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.5rem);
  }
  .bento__card p {
    margin: 0;
    color: var(--c-ink-muted);
  }
  .bento__card .link-arrow {
    margin-top: auto;
    padding-top: 8px;
    color: var(--c-blue-600);
  }

  .bento__card--about {
    justify-content: center;
    background:
      radial-gradient(70% 60% at 100% 0%, rgb(0 160 236 / 0.28) 0%, transparent 70%),
      var(--c-navy-900);
    border: 0;
    color: #c9d8ea;
  }
  .bento__card--about .eyebrow {
    color: var(--c-cyan-400);
    margin-bottom: 4px;
  }
  .bento__card--about h2 {
    color: #fff;
    margin: 0 0 6px;
  }
  .bento__card--about p {
    color: #c9d8ea;
  }
  .bento__stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 8px clamp(20px, 4vw, 36px);
    margin: 18px 0 10px;
  }
  .bento__stats div {
    display: flex;
    flex-direction: column;
  }
  .bento__stats dd {
    order: -1;
  }
  .bento__stats dd {
    margin: 0;
    font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .bento__stats dt {
    margin-top: 6px;
    font-size: 0.875rem;
    color: #a9bdd6;
  }
  .bento__card--about .bento__link-light {
    margin-top: 8px;
    color: #fff;
  }
  .bento__link-light:hover {
    color: var(--c-cyan-400);
  }

  .bento__tag {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--c-blue-100);
    color: var(--c-blue-700);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .bento__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #fff;
    color: var(--c-blue-600);
    box-shadow: var(--shadow-sm);
  }

  /* Mini grafikon s pragom pokrića */
  .mini-chart {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 110px;
    margin-top: 10px;
    padding: 10px 12px 0;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--c-line);
  }
