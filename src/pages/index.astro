---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HomeHero from '../components/HomeHero.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ServiceGuide from '../components/ServiceGuide.astro';
import ArticleCards from '../components/ArticleCards.astro';
import FaqList from '../components/FaqList.astro';
import { services } from '../data/services.ts';
import { generalFaq } from '../data/faq.ts';
import { reviews, initials } from '../data/reviews.ts';
import { site, fullAddress } from '../data/site.ts';
import { organizationSchema } from '../lib/schema.ts';

// Zašto nam vjerovati: samo potvrđene tvrdnje agencije i činjenice s postojećeg weba.
const trust = [
  { icon: 'shield', title: 'Ovlašteno zastupanje', text: 'stranih poreznih obveznika' },
  { icon: 'pin', title: 'Lokalno, u Mostaru', text: 'Lacina bb, Villa Neretva' },
  { icon: 'mail', title: 'Dokumentacija i e-mailom', text: 'digitalna dostava dokumentacije' },
  { icon: 'sliders', title: 'Individualna ponuda', text: 'prema obimu i složenosti posla' },
] as const;

const featuredReviews = reviews.filter((r) => r.text.length > 40);
const shortReviews = reviews.filter((r) => r.text.length <= 40);
---

<Base
  title="Računovodstvo Mostar | Agencija ACCOUNT"
  description="Računovodstvo, porezne prijave i poslovno savjetovanje u Mostaru. Upoznajte usluge agencije ACCOUNT i zatražite ponudu za svoje poslovanje."
  jsonLd={[organizationSchema()]}
>
  <HomeHero />

  <section class="section services-overview" id="usluge" aria-labelledby="usluge-naslov">
    <div class="container services-overview__grid">
      <div class="services-overview__intro" data-reveal>
        <p class="eyebrow">Kako vam pomažemo</p>
        <h2 id="usluge-naslov">Šta vam je potrebno?</h2>
        <p>Od urednih poslovnih knjiga do savjeta za naredni korak. Izaberite oblast koja odgovara vašem poslovanju.</p>
        <a class="link-arrow" href="/usluge">Pregled svih usluga <Icon name="arrow" size={18} /></a>
      </div>
      <ol class="services-overview__list" data-reveal>
        {
          services.map((s, i) => (
            <li>
              <a href={`/${s.slug}`}>
                <span class="services-overview__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="services-overview__detail">
                  <strong>{s.title}</strong>
                  <span>{s.benefit}</span>
                </span>
                <Icon name="arrow" size={22} class="services-overview__arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 3. Zašto nam vjerovati -->
  <section class="trust" aria-labelledby="zasto-naslov">
    <div class="container trust__grid">
      <div class="trust__heading" data-reveal>
        <p class="eyebrow">Zašto nam vjerovati</p>
        <h2 id="zasto-naslov">Lokalna stručnost. Jasan govor.</h2>
      </div>
      <div class="trust__body" data-reveal>
        <p class="trust__lead">
          ACCOUNT je računovodstvena agencija iz Mostara s više od 10 godina iskustva i više od 300 klijenata. Firmama,
          obrtima, udruženjima i inostranim preduzećima pomažemo da imaju uredne evidencije i jasan pregled poslovanja.
        </p>
        <ul class="trust__list">
          {
            trust.map((t) => (
              <li>
                <span class="trust__icon"><Icon name={t.icon} size={20} /></span>
                <span>
                  <strong>{t.title}</strong>
                  <span>{t.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <a class="link-arrow trust__link" href="/o-nama">Više o nama <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- 4. Recenzije -->
  <section class="section surface-cream reviews" aria-labelledby="recenzije-naslov">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Recenzije</p>
        <h2 id="recenzije-naslov">Šta kažu klijenti</h2>
      </div>
      <div class="reviews__grid">
        {
          featuredReviews.map((r, i) => (
            <figure class="review" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
              <svg class="review__mark" viewBox="0 0 32 24" width="32" height="24" aria-hidden="true" focusable="false">
                <path d="M0 24V14C0 6 4 1.5 12 0l1.5 3.2C9 4.6 7 7.4 7 11h6v13zm18 0V14c0-8 4-12.5 12-14l1.5 3.2C27 4.6 25 7.4 25 11h6v13z" fill="currentColor" />
              </svg>
              <blockquote>
                <p>{r.text}</p>
              </blockquote>
              <figcaption>
                <span class="review__avatar" aria-hidden="true">
                  {initials(r.name)}
                </span>
                {r.name}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <ul class="reviews__short" data-reveal>
        {
          shortReviews.map((r) => (
            <li>
              <span class="review__avatar review__avatar--small" aria-hidden="true">
                {initials(r.name)}
              </span>
              <span>
                „{r.text}“ <span class="reviews__name">— {r.name}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="reviews__source">Recenzije objavljene na dosadašnjoj web stranici agencije.</p>
    </div>
  </section>

  <!-- 5. Tri koraka saradnje -->
  <ProcessSection />

  <!-- 6. Alat -->
  <section class="section section--tint" aria-labelledby="vodic-naslov">
    <div class="container guide-wrap">
      <div class="guide-wrap__intro" data-reveal>
        <p class="eyebrow">Vodič</p>
        <h2 id="vodic-naslov">Koja vam usluga treba?</h2>
        <p>Tri kratka pitanja do preporuke i liste za prvi razgovor. Kontakt podaci nisu potrebni.</p>
        <ul class="tool-links">
          <li>
            <a class="link-arrow" href="/korisni-alati#kalkulator">Kalkulator pokrića troškova <Icon name="arrow" size={18} /></a>
          </li>
          <li>
            <a class="link-arrow" href="/korisni-alati#konfigurator">Konfigurator upita <Icon name="arrow" size={18} /></a>
          </li>
        </ul>
      </div>
      <ServiceGuide id="vodic-pocetna" />
    </div>
  </section>

  <!-- 7. Savjeti -->
  <section class="section" aria-labelledby="savjeti-naslov">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">Savjeti</p>
          <h2 id="savjeti-naslov">Korisno za vaše poslovanje</h2>
        </div>
        <a class="link-arrow" href="/savjeti">Svi savjeti <Icon name="arrow" size={18} /></a>
      </div>
      <ArticleCards images={false} />
    </div>
  </section>

  <!-- 8. Kontakt -->
  <section class="section section--tint" aria-labelledby="faq-naslov">
    <div class="container faq-contact">
      <div data-reveal>
        <p class="eyebrow">Česta pitanja</p>
        <h2 id="faq-naslov">Prije prvog razgovora</h2>
        <FaqList items={generalFaq.slice(0, 3)} />
      </div>
      <aside class="contact-card" aria-labelledby="kontakt-kartica-naslov" data-reveal>
        <h2 id="kontakt-kartica-naslov">Razgovarajmo o vašem poslovanju</h2>
        <p>Pošaljite upit ili nas pozovite. Ponudu pripremamo prema obimu i potrebama vašeg poslovanja.</p>
        <ul class="contact-card__list">
          {
            site.phones.map((p) => (
              <li>
                <Icon name="phone" size={18} />
                <a href={p.href} data-track="klik_telefon">
                  {p.display}
                </a>
                <span class="contact-card__label">{p.label}</span>
              </li>
            ))
          }
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Icon name="pin" size={18} />
            <a href={site.mapsUrl} rel="noopener" target="_blank">
              {fullAddress}<span class="visually-hidden"> (Google Maps, otvara se u novom prozoru)</span>
            </a>
          </li>
        </ul>
        <a class="btn btn--bright" href="/kontakt#upit">Zatražite ponudu <Icon name="arrow" size={18} /></a>
      </aside>
    </div>
  </section>
</Base>

<style>
  /* Usluge: pet jasnih putanja bez jednakih kartica. */
  .services-overview { background: #fff; }
  .services-overview__grid { display: grid; gap: 28px; }
  .services-overview__intro h2 {
    font-size: clamp(2.25rem, 3.1vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 1.08;
  }
  .services-overview__intro p:not(.eyebrow) {
    max-width: 28rem;
    color: var(--c-ink-muted);
  }
  .services-overview__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--c-line);
  }
  .services-overview__list a {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 24px;
    align-items: center;
    gap: 16px;
    min-height: 94px;
    padding: 18px 0;
    border-bottom: 1px solid var(--c-line);
    color: var(--c-navy-900);
    text-decoration: none;
  }
  .services-overview__list a:hover strong { color: var(--c-blue-700); }
  .services-overview__number {
    align-self: start;
    padding-top: 1px;
    color: var(--c-blue-600);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .services-overview__detail { display: grid; gap: 5px; }
  .services-overview__detail strong {
    font-size: clamp(1.0625rem, 1.4vw, 1.375rem);
    line-height: 1.25;
  }
  .services-overview__detail > span {
    font-size: .9375rem;
    line-height: 1.45;
    color: var(--c-ink-muted);
  }
  .services-overview__list :global(.services-overview__arrow) {
    color: var(--c-blue-600);
    transition: transform .2s ease;
  }
  .services-overview__list a:hover :global(.services-overview__arrow) { transform: translateX(4px); }
  @media (min-width: 960px) {
    .services-overview__grid { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 7vw; }
    .services-overview__intro { position: sticky; top: calc(var(--header-h) + 40px); align-self: start; }
  }

  /* Povjerenje nosi tipografija i provjerene činjenice. */
  .trust {
    background: var(--c-navy-950);
    color: #c9d4e3;
  }
  .trust__grid { display: grid; gap: 18px; padding-block: clamp(65px, 7vw, 112px); }
  .trust h2 { color: #fff; font-size: clamp(2.25rem, 3.6vw, 4rem); letter-spacing: -.045em; }
  .trust .eyebrow { color: #49c7fa; }
  .trust .eyebrow::before { background: #49c7fa; }
  .trust__lead { max-width: 37rem; color: #dee7f2; font-size: 1.0625rem; }
  .trust__list { display: grid; gap: 0; list-style: none; padding: 0; margin: 28px 0; }
  .trust__list li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid rgb(255 255 255 / .18);
    font-size: .9375rem;
    line-height: 1.4;
    color: #c0d0e2;
  }
  .trust__list li:last-child { border-bottom: 1px solid rgb(255 255 255 / .18); }
  .trust__list strong { display: block; color: #fff; font-weight: 700; }
  .trust__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    color: #49c7fa;
  }
  .trust__link { color: #fff; }
  .trust__link:hover { color: #49c7fa; }
  .trust :global(:focus-visible) { outline-color: #fff; }
  @media (min-width: 900px) {
    .trust__grid { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 8vw; }
  }

  /* Recenzije: urednički prikaz citata */
  .reviews__grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .reviews__grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }
  .review {
    position: relative;
    margin: 0;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--c-cream-line);
  }
  .review__mark {
    display: block;
    margin-bottom: 16px;
    color: var(--c-blue-500);
  }
  .review blockquote {
    position: relative;
    margin: 0 0 22px;
  }
  .review blockquote p {
    margin: 0;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--c-navy-900);
    max-width: 34rem;
  }
  .review figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 750;
    color: var(--c-navy-900);
  }
  .review__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--c-navy-900);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .review__avatar--small {
    width: 32px;
    height: 32px;
    font-size: 0.75rem;
    background: var(--c-blue-600);
  }
  .reviews__short {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }
  .reviews__short li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--c-navy-900);
  }
  .reviews__name {
    font-weight: 500;
    color: var(--c-ink-muted);
  }
  .reviews__source {
    margin: 22px 0 0;
    font-size: 0.875rem;
    color: var(--c-ink-muted);
  }

  /* Vodič */
  .guide-wrap {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .guide-wrap {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
    }
  }
  .guide-wrap__intro p {
    color: var(--c-ink-muted);
    max-width: 30rem;
  }
  .tool-links {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  /* Savjeti */
  .section-head--row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    max-width: none;
  }
  .section-head--row h2 {
    margin: 0;
  }

  /* FAQ i kontakt */
  .faq-contact {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .faq-contact {
      grid-template-columns: 1.3fr 1fr;
      gap: 72px;
    }
  }
  .contact-card {
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--c-navy-900);
    color: #c9d4e3;
  }
  .contact-card h2 {
    font-size: 1.5rem;
    color: #fff;
  }
  .contact-card__list {
    list-style: none;
    margin: 24px 0 28px;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .contact-card__list li {
    display: grid;
    grid-template-columns: 18px 1fr;
    column-gap: 12px;
    align-items: start;
    overflow-wrap: anywhere;
  }
  .contact-card__list :global(svg) {
    margin-top: 4px;
    color: var(--c-cyan-400);
  }
  .contact-card__list a {
    font-weight: 650;
    color: #fff;
  }
  .contact-card__label {
    grid-column: 2;
    font-size: 0.85rem;
    color: #9fb0c6;
  }
  .contact-card :global(:focus-visible) {
    outline-color: #fff;
  }
</style>
