---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HomeHero from '../components/HomeHero.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ServiceGuide from '../components/ServiceGuide.astro';
import ArticleCards from '../components/ArticleCards.astro';
import FaqList from '../components/FaqList.astro';
import { services, audiences } from '../data/services.ts';
import { generalFaq } from '../data/faq.ts';
import { reviews, initials } from '../data/reviews.ts';
import { site, fullAddress } from '../data/site.ts';
import { organizationSchema } from '../lib/schema.ts';

const [featured, ...rest] = services;

// Zašto nam vjerovati: samo potvrđene tvrdnje agencije i činjenice s postojećeg weba.
const trust = [
  { icon: 'shield', title: 'Ovlašteno zastupanje', text: 'stranih poreznih obveznika' },
  { icon: 'pin', title: 'Lokalno, u Mostaru', text: 'Lacina bb, Villa Neretva' },
  { icon: 'mail', title: 'Dokumentacija i e-mailom', text: 'digitalna dostava dokumentacije' },
  { icon: 'sliders', title: 'Individualna ponuda', text: 'prema obimu i složenosti posla' },
] as const;

const featuredReviews = reviews.filter((r) => r.text.length > 40);
const shortReviews = reviews.filter((r) => r.text.length <= 40);
---

<Base
  title="Računovodstvo Mostar | Agencija ACCOUNT"
  description="Računovodstvo, porezne prijave i poslovno savjetovanje u Mostaru. Upoznajte usluge agencije ACCOUNT i zatražite ponudu za svoje poslovanje."
  jsonLd={[organizationSchema()]}
>
  <HomeHero />

  <!-- 1. Kome pomažemo -->
  <section class="section section--tight audiences" aria-labelledby="kome-naslov">
    <div class="container audiences__grid">
      <div class="audiences__head">
        <p class="eyebrow">Kome pomažemo</p>
        <h2 id="kome-naslov">Od prvog koraka do urednog poslovanja</h2>
      </div>
      <ul class="audiences__list">
        {
          audiences.map((a) => (
            <li>
              <a href={`/${a.slug}`}>
                <span class="audiences__name">{a.title}</span>
                <span class="audiences__text">{a.text}</span>
                <Icon name="arrow" size={18} class="audiences__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 2. Usluge: jedna izdvojena s fotografijom, ostale u konciznoj listi -->
  <section class="section surface-cream" id="usluge" aria-labelledby="usluge-naslov">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Usluge</p>
        <h2 id="usluge-naslov">Podrška za svaku fazu poslovanja</h2>
      </div>

      <article class="svc-featured" data-reveal>
        <ResponsiveImage
          name={featured.image}
          alt={featured.imageAlt}
          sizes="(min-width: 1024px) 600px, 100vw"
          class="media svc-featured__media"
        />
        <div class="svc-featured__body">
          <h3><a href={`/${featured.slug}`}>{featured.title}</a></h3>
          <p class="svc-featured__benefit">{featured.intro}</p>
          <ul class="checklist">
            {featured.scope.slice(0, 4).map((item) => <li>{item}</li>)}
          </ul>
          <a class="btn btn--small" href={`/${featured.slug}`}>
            Više o usluzi<span class="visually-hidden">: {featured.title}</span>
          </a>
        </div>
      </article>

      <ul class="svc-list" data-reveal>
        {
          rest.map((s) => (
            <li>
              <a href={`/${s.slug}`}>
                <span class="svc-list__title">{s.title}</span>
                <span class="svc-list__text">{s.benefit}</span>
                <Icon name="arrow" size={20} class="svc-list__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Zašto nam vjerovati -->
  <section class="trust" aria-labelledby="zasto-naslov">
    <div class="trust__media">
      <ResponsiveImage
        name="account-savjetovanje"
        alt="Dvije osobe za stolom razgovaraju nad jednostavnim finansijskim prikazom, pored tamnoplavog fascikla sa znakom ACCOUNT (ilustrativna scena)"
        sizes="(min-width: 900px) 52vw, 100vw"
        class="trust__photo"
      />
    </div>
    <div class="container trust__grid">
      <div class="trust__body" data-reveal>
        <p class="eyebrow">Zašto nam vjerovati</p>
        <h2 id="zasto-naslov">Lokalna stručnost, jasan govor</h2>
        <p class="trust__lead">
          ACCOUNT je računovodstvena agencija iz Mostara s više od 10 godina iskustva i više od 300 klijenata. Firmama,
          obrtima, udruženjima i inostranim preduzećima pomažemo da imaju uredne evidencije i jasan pregled poslovanja.
        </p>
        <ul class="trust__list">
          {
            trust.map((t) => (
              <li>
                <span class="trust__icon"><Icon name={t.icon} size={20} /></span>
                <span>
                  <strong>{t.title}</strong>
                  <span>{t.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <a class="link-arrow trust__link" href="/o-nama">Više o nama <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- 4. Recenzije -->
  <section class="section surface-cream reviews" aria-labelledby="recenzije-naslov">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Recenzije</p>
        <h2 id="recenzije-naslov">Šta kažu klijenti</h2>
      </div>
      <div class="reviews__grid">
        {
          featuredReviews.map((r, i) => (
            <figure class="review" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
              <svg class="review__mark" viewBox="0 0 32 24" width="32" height="24" aria-hidden="true" focusable="false">
                <path d="M0 24V14C0 6 4 1.5 12 0l1.5 3.2C9 4.6 7 7.4 7 11h6v13zm18 0V14c0-8 4-12.5 12-14l1.5 3.2C27 4.6 25 7.4 25 11h6v13z" fill="currentColor" />
              </svg>
              <blockquote>
                <p>{r.text}</p>
              </blockquote>
              <figcaption>
                <span class="review__avatar" aria-hidden="true">
                  {initials(r.name)}
                </span>
                {r.name}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <ul class="reviews__short" data-reveal>
        {
          shortReviews.map((r) => (
            <li>
              <span class="review__avatar review__avatar--small" aria-hidden="true">
                {initials(r.name)}
              </span>
              <span>
                „{r.text}“ <span class="reviews__name">— {r.name}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="reviews__source">Recenzije objavljene na dosadašnjoj web stranici agencije.</p>
    </div>
  </section>

  <!-- 5. Tri koraka saradnje -->
  <ProcessSection />

  <!-- 6. Alat -->
  <section class="section section--tint" aria-labelledby="vodic-naslov">
    <div class="container guide-wrap">
      <div class="guide-wrap__intro" data-reveal>
        <p class="eyebrow">Vodič</p>
        <h2 id="vodic-naslov">Koja vam usluga treba?</h2>
        <p>Tri kratka pitanja do preporuke i liste za prvi razgovor. Kontakt podaci nisu potrebni.</p>
        <ul class="tool-links">
          <li>
            <a class="link-arrow" href="/korisni-alati#kalkulator">Kalkulator pokrića troškova <Icon name="arrow" size={18} /></a>
          </li>
          <li>
            <a class="link-arrow" href="/korisni-alati#konfigurator">Konfigurator upita <Icon name="arrow" size={18} /></a>
          </li>
        </ul>
      </div>
      <ServiceGuide id="vodic-pocetna" />
    </div>
  </section>

  <!-- 7. Savjeti -->
  <section class="section" aria-labelledby="savjeti-naslov">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">Savjeti</p>
          <h2 id="savjeti-naslov">Korisno za vaše poslovanje</h2>
        </div>
        <a class="link-arrow" href="/savjeti">Svi savjeti <Icon name="arrow" size={18} /></a>
      </div>
      <ArticleCards images={false} />
    </div>
  </section>

  <!-- 8. Kontakt -->
  <section class="section section--tint" aria-labelledby="faq-naslov">
    <div class="container faq-contact">
      <div data-reveal>
        <p class="eyebrow">Česta pitanja</p>
        <h2 id="faq-naslov">Prije prvog razgovora</h2>
        <FaqList items={generalFaq.slice(0, 3)} />
      </div>
      <aside class="contact-card" aria-labelledby="kontakt-kartica-naslov" data-reveal>
        <h2 id="kontakt-kartica-naslov">Razgovarajmo o vašem poslovanju</h2>
        <p>Pošaljite upit ili nas pozovite. Ponudu pripremamo prema obimu i potrebama vašeg poslovanja.</p>
        <ul class="contact-card__list">
          {
            site.phones.map((p) => (
              <li>
                <Icon name="phone" size={18} />
                <a href={p.href} data-track="klik_telefon">
                  {p.display}
                </a>
                <span class="contact-card__label">{p.label}</span>
              </li>
            ))
          }
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Icon name="pin" size={18} />
            <a href={site.mapsUrl} rel="noopener" target="_blank">
              {fullAddress}<span class="visually-hidden"> (Google Maps, otvara se u novom prozoru)</span>
            </a>
          </li>
        </ul>
        <a class="btn btn--bright" href="/kontakt#upit">Zatražite ponudu <Icon name="arrow" size={18} /></a>
      </aside>
    </div>
  </section>
</Base>

<style>
  /* Kome pomažemo */
  .audiences__grid {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .audiences__grid {
      grid-template-columns: 0.8fr 2.2fr;
      gap: 48px;
      align-items: center;
    }
  }
  .audiences__head h2 {
    margin: 0;
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }
  .audiences__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--c-line);
  }
  @media (min-width: 640px) {
    .audiences__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
    }
  }
  .audiences__list a {
    position: relative;
    display: grid;
    gap: 2px;
    height: 100%;
    padding: 16px 40px 16px 0;
    border-bottom: 1px solid var(--c-line);
    text-decoration: none;
    color: var(--c-ink);
  }
  .audiences__name {
    font-weight: 750;
    color: var(--c-navy-900);
  }
  .audiences__text {
    font-size: 0.9375rem;
    color: var(--c-ink-muted);
  }
  .audiences__list a:hover .audiences__name {
    color: var(--c-blue-600);
  }
  .audiences__list :global(.audiences__arrow) {
    position: absolute;
    right: 4px;
    top: 50%;
    margin-top: -9px;
    color: var(--c-blue-600);
    transition: transform 0.18s ease;
  }
  .audiences__list a:hover :global(.audiences__arrow) {
    transform: translateX(3px);
  }

  /* Usluge */
  .svc-featured {
    display: grid;
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .svc-featured {
      grid-template-columns: 1.05fr 1fr;
    }
  }
  :global(.media.svc-featured__media) {
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  .svc-featured__body {
    padding: clamp(24px, 3.5vw, 52px);
    align-self: center;
  }
  .svc-featured h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }
  .svc-featured h3 a {
    color: var(--c-navy-900);
    text-decoration: none;
  }
  .svc-featured h3 a:hover {
    color: var(--c-blue-600);
  }
  .svc-featured__benefit {
    color: var(--c-ink-muted);
    max-width: 34rem;
  }
  .svc-featured .checklist {
    margin: 22px 0 28px;
  }

  .svc-list {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--c-cream-line);
  }
  @media (min-width: 768px) {
    .svc-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 40px;
    }
  }
  .svc-list a {
    position: relative;
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 22px 48px 22px 0;
    border-bottom: 1px solid var(--c-cream-line);
    text-decoration: none;
    color: var(--c-ink);
  }
  .svc-list__title {
    font-size: 1.1875rem;
    font-weight: 750;
    color: var(--c-navy-900);
  }
  .svc-list__text {
    color: var(--c-ink-muted);
    font-size: 0.975rem;
  }
  .svc-list a:hover .svc-list__title {
    color: var(--c-blue-600);
  }
  .svc-list :global(.svc-list__arrow) {
    position: absolute;
    right: 4px;
    top: 50%;
    margin-top: -10px;
    color: var(--c-blue-600);
    transition: transform 0.18s ease;
  }
  .svc-list a:hover :global(.svc-list__arrow) {
    transform: translateX(4px);
  }

  /* Zašto nam vjerovati: tamna sekcija; fotografija s vinjetom stapa se s pozadinom */
  .trust {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--c-navy-950);
    color: #c9d4e3;
  }
  .trust__media {
    position: relative;
    aspect-ratio: 4 / 3;
    max-height: 460px;
    width: 100%;
  }
  .trust__media :global(.trust__photo) {
    position: absolute;
    inset: 0;
    display: block;
    -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
  }
  .trust__media :global(.trust__photo img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 45%;
  }
  .trust__grid {
    position: relative;
    z-index: 1;
    padding-block: 8px 72px;
  }
  @media (min-width: 900px) {
    .trust__media {
      position: absolute;
      inset: 0 auto 0 0;
      width: 52%;
      max-height: none;
      aspect-ratio: auto;
    }
    .trust__media :global(.trust__photo) {
      -webkit-mask-image: linear-gradient(90deg, #000 55%, transparent 100%);
      mask-image: linear-gradient(90deg, #000 55%, transparent 100%);
    }
    .trust__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding-block: clamp(80px, 8vw, 120px);
    }
    .trust__body {
      grid-column: 2;
    }
  }
  .trust h2 {
    color: #fff;
  }
  .trust .eyebrow {
    color: var(--c-cyan-400);
  }
  .trust .eyebrow::before {
    background: var(--c-cyan-400);
  }
  .trust__lead {
    max-width: 34rem;
    color: #c9d4e3;
    font-size: 1.0625rem;
  }
  .trust__list {
    list-style: none;
    margin: 28px 0;
    padding: 0;
    display: grid;
    gap: 18px 24px;
  }
  @media (min-width: 560px) {
    .trust__list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .trust__list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: #a9bad0;
  }
  .trust__list strong {
    display: block;
    color: #fff;
    font-weight: 700;
  }
  .trust__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid rgb(255 255 255 / 0.16);
    color: var(--c-cyan-400);
  }
  .trust__link {
    color: #fff;
  }
  .trust__link:hover {
    color: var(--c-cyan-400);
  }
  .trust :global(:focus-visible) {
    outline-color: #fff;
  }

  /* Recenzije: urednički prikaz citata */
  .reviews__grid {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .reviews__grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }
  .review {
    position: relative;
    margin: 0;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--c-cream-line);
  }
  .review__mark {
    display: block;
    margin-bottom: 16px;
    color: var(--c-blue-500);
  }
  .review blockquote {
    position: relative;
    margin: 0 0 22px;
  }
  .review blockquote p {
    margin: 0;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--c-navy-900);
    max-width: 34rem;
  }
  .review figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 750;
    color: var(--c-navy-900);
  }
  .review__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--c-navy-900);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .review__avatar--small {
    width: 32px;
    height: 32px;
    font-size: 0.75rem;
    background: var(--c-blue-600);
  }
  .reviews__short {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }
  .reviews__short li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--c-navy-900);
  }
  .reviews__name {
    font-weight: 500;
    color: var(--c-ink-muted);
  }
  .reviews__source {
    margin: 22px 0 0;
    font-size: 0.875rem;
    color: var(--c-ink-muted);
  }

  /* Vodič */
  .guide-wrap {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .guide-wrap {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
    }
  }
  .guide-wrap__intro p {
    color: var(--c-ink-muted);
    max-width: 30rem;
  }
  .tool-links {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  /* Savjeti */
  .section-head--row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    max-width: none;
  }
  .section-head--row h2 {
    margin: 0;
  }

  /* FAQ i kontakt */
  .faq-contact {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .faq-contact {
      grid-template-columns: 1.3fr 1fr;
      gap: 72px;
    }
  }
  .contact-card {
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--c-navy-900);
    color: #c9d4e3;
  }
  .contact-card h2 {
    font-size: 1.5rem;
    color: #fff;
  }
  .contact-card__list {
    list-style: none;
    margin: 24px 0 28px;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .contact-card__list li {
    display: grid;
    grid-template-columns: 18px 1fr;
    column-gap: 12px;
    align-items: start;
    overflow-wrap: anywhere;
  }
  .contact-card__list :global(svg) {
    margin-top: 4px;
    color: var(--c-cyan-400);
  }
  .contact-card__list a {
    font-weight: 650;
    color: #fff;
  }
  .contact-card__label {
    grid-column: 2;
    font-size: 0.85rem;
    color: #9fb0c6;
  }
  .contact-card :global(:focus-visible) {
    outline-color: #fff;
  }
</style>
