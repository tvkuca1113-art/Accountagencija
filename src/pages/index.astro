---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HomeHero from '../components/HomeHero.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ServiceGuide from '../components/ServiceGuide.astro';
import ArticleList from '../components/ArticleList.astro';
import FaqList from '../components/FaqList.astro';
import { services, audiences } from '../data/services.ts';
import { generalFaq } from '../data/faq.ts';
import { reviews, initials } from '../data/reviews.ts';
import { site, fullAddress } from '../data/site.ts';
import { organizationSchema } from '../lib/schema.ts';

const [leadReview, ...otherReviews] = reviews.filter((r) => r.text.length > 40);
const shortReviews = reviews.filter((r) => r.text.length <= 40);
---

<Base
  title="Računovodstvo Mostar | Agencija ACCOUNT"
  description="Računovodstvo, porezne prijave i poslovno savjetovanje u Mostaru. Upoznajte usluge agencije ACCOUNT i zatražite ponudu za svoje poslovanje."
  jsonLd={[organizationSchema()]}
>
  <HomeHero />

  <!-- 1. Pet usluga: numerisana urednička lista -->
  <section class="section surface-stone services" id="usluge" aria-labelledby="usluge-naslov">
    <div class="container services__grid">
      <div class="services__head" data-reveal>
        <p class="eyebrow">Usluge</p>
        <h2 id="usluge-naslov">Šta radimo za vaše poslovanje</h2>
        <p>Pet oblasti, od registracije do urednih knjiga i planiranja. Obim svake usluge dogovaramo na početku saradnje.</p>
        <a class="link-arrow" href="#vodic">Niste sigurni šta vam treba? <Icon name="arrow" size={18} /></a>
      </div>
      <ol class="services__list">
        {
          services.map((s, i) => (
            <li class="services__item" data-reveal>
              <span class="services__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>
                  <a href={`/${s.slug}`}>{s.title}</a>
                </h3>
                <p>{s.intro}</p>
              </div>
              <Icon name="arrow" size={22} class="services__arrow" />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 2. Za koga -->
  <section class="section audiences" aria-labelledby="kome-naslov">
    <div class="container">
      <div class="audiences__head" data-reveal>
        <p class="eyebrow">Za koga radimo</p>
        <h2 id="kome-naslov">Firme, obrti, novi preduzetnici i inostrana preduzeća</h2>
      </div>
      <ul class="audiences__list" data-reveal>
        {
          audiences.map((a) => (
            <li>
              <a href={`/${a.slug}`}>
                <span class="audiences__name">{a.title}</span>
                <span class="audiences__text">{a.text}</span>
                <span class="audiences__more">
                  {services.find((s) => s.slug === a.slug)?.title}
                  <Icon name="arrow" size={16} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Dokaz: potvrđeni podaci i recenzije s dosadašnjeg weba -->
  <section class="section proof" aria-labelledby="dokaz-naslov">
    <div class="container">
      <div class="proof__top">
        <div data-reveal>
          <p class="eyebrow proof__eyebrow">Iskustvo i preporuke</p>
          <h2 id="dokaz-naslov">Lokalna agencija s više od deset godina iskustva</h2>
        </div>
        <dl class="proof__facts" data-reveal>
          {
            site.stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
          <div class="proof__fact-text">
            <dt>stranih poreznih obveznika</dt>
            <dd>Ovlašteno zastupanje</dd>
          </div>
        </dl>
      </div>

      <div class="proof__reviews">
        {
          leadReview && (
            <figure class="quote quote--lead" data-reveal>
              <blockquote>
                <p>„{leadReview.text}“</p>
              </blockquote>
              <figcaption>
                <span class="quote__avatar" aria-hidden="true">
                  {initials(leadReview.name)}
                </span>
                {leadReview.name}
              </figcaption>
            </figure>
          )
        }
        <div class="proof__side" data-reveal>
          {
            otherReviews.map((r) => (
              <figure class="quote">
                <blockquote>
                  <p>„{r.text}“</p>
                </blockquote>
                <figcaption>
                  <span class="quote__avatar" aria-hidden="true">
                    {initials(r.name)}
                  </span>
                  {r.name}
                </figcaption>
              </figure>
            ))
          }
          <ul class="proof__short">
            {
              shortReviews.map((r) => (
                <li>
                  „{r.text}“ <span>— {r.name}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="proof__source">Recenzije objavljene na dosadašnjoj web stranici agencije, s imenima i tekstom kako su objavljene.</p>
    </div>
  </section>

  <!-- 4. Saradnja -->
  <ProcessSection />

  <!-- 5. Korisni alat -->
  <section class="section" id="vodic" aria-labelledby="vodic-naslov">
    <div class="container guide-wrap">
      <div class="guide-wrap__intro" data-reveal>
        <p class="eyebrow">Korisni alat</p>
        <h2 id="vodic-naslov">Koja vam usluga treba?</h2>
        <p>Tri kratka pitanja do preporuke i liste za prvi razgovor. Kontakt podaci nisu potrebni.</p>
        <ul class="tool-links">
          <li>
            <a class="link-arrow" href="/korisni-alati#kalkulator">Kalkulator pokrića troškova <Icon name="arrow" size={18} /></a>
          </li>
          <li>
            <a class="link-arrow" href="/korisni-alati#konfigurator">Konfigurator upita <Icon name="arrow" size={18} /></a>
          </li>
        </ul>
      </div>
      <ServiceGuide id="vodic-pocetna" />
    </div>
  </section>

  <!-- 6. Savjeti -->
  <section class="section surface-stone" aria-labelledby="savjeti-naslov">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">Savjeti</p>
          <h2 id="savjeti-naslov">Korisno za vaše poslovanje</h2>
        </div>
        <a class="link-arrow" href="/savjeti">Svi savjeti <Icon name="arrow" size={18} /></a>
      </div>
      <ArticleList />
    </div>
  </section>

  <!-- 7. Kontakt -->
  <section class="section" aria-labelledby="faq-naslov">
    <div class="container faq-contact">
      <div data-reveal>
        <p class="eyebrow">Česta pitanja</p>
        <h2 id="faq-naslov">Prije prvog razgovora</h2>
        <FaqList items={generalFaq.slice(0, 3)} />
      </div>
      <aside class="contact-card" aria-labelledby="kontakt-kartica-naslov" data-reveal>
        <h2 id="kontakt-kartica-naslov">Vi vodite posao. Mi brinemo o računovodstvu.</h2>
        <p>Pošaljite upit ili nas pozovite. Ponudu pripremamo prema obimu i potrebama vašeg poslovanja.</p>
        <ul class="contact-card__list">
          {
            site.phones.map((p) => (
              <li>
                <Icon name="phone" size={18} />
                <a href={p.href} data-track="klik_telefon">
                  {p.display}
                </a>
                <span class="contact-card__label">{p.label}</span>
              </li>
            ))
          }
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Icon name="pin" size={18} />
            <a href={site.mapsUrl} rel="noopener" target="_blank">
              {fullAddress}<span class="visually-hidden"> (Google Maps, otvara se u novom prozoru)</span>
            </a>
          </li>
        </ul>
        <a class="btn btn--bright" href="/kontakt#upit">Zatražite ponudu <Icon name="arrow" size={18} /></a>
      </aside>
    </div>
  </section>
</Base>

<style>
  /* Usluge */
  .services__grid {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: 0.85fr 1.6fr;
      gap: 72px;
      align-items: start;
    }
    .services__head {
      position: sticky;
      top: calc(var(--header-h) + 40px);
    }
  }
  .services__head p {
    color: var(--c-ink-muted);
    max-width: 26rem;
  }
  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--c-stone-line);
  }
  .services__item {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 16px;
    padding: 26px 44px 28px 0;
    border-bottom: 1px solid var(--c-stone-line);
  }
  @media (min-width: 640px) {
    .services__item {
      grid-template-columns: 5rem 1fr;
      padding-block: 32px 34px;
    }
  }
  .services__num {
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.75rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-blue-600);
    font-variant-numeric: tabular-nums;
  }
  .services__item h3 {
    margin: 0 0 8px;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
  }
  .services__item h3 a {
    color: var(--c-navy-900);
    text-decoration: none;
  }
  .services__item h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .services__item h3 a:focus-visible {
    outline: none;
  }
  .services__item:has(a:focus-visible) {
    outline: 3px solid var(--c-focus);
    outline-offset: 4px;
  }
  .services__item p {
    margin: 0;
    max-width: 38rem;
    color: var(--c-ink-muted);
  }
  .services__item :global(.services__arrow) {
    position: absolute;
    right: 4px;
    top: 34px;
    color: var(--c-blue-600);
    transition: transform 0.2s ease;
  }
  .services__item:hover h3 a {
    color: var(--c-blue-600);
  }
  .services__item:hover :global(.services__arrow) {
    transform: translateX(4px);
  }

  /* Za koga */
  .audiences__head {
    max-width: 44rem;
    margin-bottom: clamp(28px, 3vw, 44px);
  }
  .audiences__head h2 {
    margin: 0;
  }
  .audiences__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 32px;
  }
  @media (min-width: 640px) {
    .audiences__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .audiences__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .audiences__list a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 20px 0 24px;
    border-top: 2px solid var(--c-navy-900);
    text-decoration: none;
    color: var(--c-ink);
  }
  .audiences__name {
    font-size: 1.1875rem;
    font-weight: 750;
    color: var(--c-navy-900);
  }
  .audiences__text {
    color: var(--c-ink-muted);
  }
  .audiences__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 8px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--c-blue-600);
  }
  .audiences__list a:hover {
    border-top-color: var(--c-blue-500);
  }
  .audiences__list a:hover .audiences__name {
    color: var(--c-blue-600);
  }

  /* Dokaz */
  .proof {
    background: var(--c-ink-950);
    color: #c7d0dc;
  }
  .proof h2 {
    color: #fff;
    margin: 0;
    max-width: 16ch;
  }
  .proof__eyebrow {
    color: #7fcdf2;
  }
  .proof__top {
    display: grid;
    gap: 32px;
    align-items: end;
    padding-bottom: clamp(32px, 4vw, 56px);
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  @media (min-width: 1024px) {
    .proof__top {
      grid-template-columns: 1fr 1.1fr;
      gap: 64px;
    }
  }
  .proof__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 32px;
    margin: 0;
  }
  @media (min-width: 640px) {
    .proof__facts {
      grid-template-columns: auto auto 1fr;
    }
  }
  .proof__facts div {
    display: flex;
    flex-direction: column;
  }
  .proof__facts dd {
    order: -1;
    margin: 0;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #fff;
  }
  .proof__facts dt {
    margin-top: 8px;
    color: #a9b5c5;
  }
  .proof__fact-text {
    grid-column: 1 / -1;
  }
  @media (min-width: 640px) {
    .proof__fact-text {
      grid-column: auto;
      padding-left: 28px;
      border-left: 1px solid rgb(255 255 255 / 0.16);
    }
  }
  .proof__facts .proof__fact-text dd {
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .proof__reviews {
    display: grid;
    gap: 40px;
    padding-top: clamp(32px, 4vw, 56px);
  }
  @media (min-width: 1024px) {
    .proof__reviews {
      grid-template-columns: 1.3fr 1fr;
      gap: 64px;
    }
  }
  .quote {
    margin: 0;
  }
  .quote blockquote {
    margin: 0 0 20px;
  }
  .quote p {
    margin: 0;
    color: #e3e8ef;
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .quote--lead p {
    color: #fff;
    font-size: clamp(1.375rem, 1.15rem + 1vw, 2rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    font-weight: 500;
  }
  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    color: #fff;
  }
  .quote__avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.3);
    font-size: 0.8125rem;
    font-weight: 800;
    color: #fff;
  }
  .proof__side {
    display: grid;
    gap: 28px;
    align-content: start;
  }
  .proof__short {
    list-style: none;
    margin: 0;
    padding: 20px 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    display: grid;
    gap: 8px;
    color: #fff;
    font-weight: 600;
  }
  .proof__short span {
    font-weight: 500;
    color: #a9b5c5;
  }
  .proof__source {
    margin: 40px 0 0;
    font-size: 0.875rem;
    color: #8f9cad;
  }

  /* Alat */
  .guide-wrap {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .guide-wrap {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 64px;
    }
  }
  .guide-wrap__intro p {
    color: var(--c-ink-muted);
    max-width: 30rem;
  }
  .tool-links {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  /* Savjeti */
  .section-head--row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    max-width: none;
  }
  .section-head--row h2 {
    margin: 0;
  }

  /* FAQ i kontakt */
  .faq-contact {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .faq-contact {
      grid-template-columns: 1.2fr 1fr;
      gap: 72px;
    }
  }
  .contact-card {
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--c-navy-900);
    color: #c7d0dc;
  }
  .contact-card h2 {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    color: #fff;
  }
  .contact-card__list {
    list-style: none;
    margin: 24px 0 28px;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .contact-card__list li {
    display: grid;
    grid-template-columns: 18px 1fr;
    column-gap: 12px;
    align-items: start;
    overflow-wrap: anywhere;
  }
  .contact-card__list :global(svg) {
    margin-top: 4px;
    color: #7fcdf2;
  }
  .contact-card__list a {
    font-weight: 650;
    color: #fff;
  }
  .contact-card__label {
    grid-column: 2;
    font-size: 0.85rem;
    color: #9fb0c6;
  }
  .contact-card :global(:focus-visible),
  .proof :global(:focus-visible) {
    outline-color: #fff;
  }
</style>
