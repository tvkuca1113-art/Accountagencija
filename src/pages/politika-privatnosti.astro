---
// Opis stvarne obrade podataka na ovoj stranici. Prije objave provjeriti s agencijom (i po potrebi pravnim savjetnikom)
// da tekst odgovara stvarnim pružaocima usluga i rokovima čuvanja — vidi docs/SADRZAJ-I-IZVORI.md.
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, fullAddress } from '../data/site.ts';

const crumbs = [
  { name: 'Početna', path: '/' },
  { name: 'Politika privatnosti', path: '/politika-privatnosti' },
];
const updated = '23. 9. 2026.';
---

<Base
  title="Politika privatnosti | Agencija ACCOUNT"
  description="Kako računovodstvena agencija ACCOUNT obrađuje podatke poslane putem kontaktnog obrasca i koje se usluge koriste na ovoj web stranici."
>
  <section class="page-head">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>Politika privatnosti</h1>
      <p class="lead">Kratko i jasno: koje podatke prikuplja ova stranica, zašto i kome se prosljeđuju.</p>
      <p class="meta">Posljednja izmjena: {updated}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="prose">
        <h2>Ko obrađuje podatke</h2>
        <p>{site.legalName}, {fullAddress}, {site.address.country}. Kontakt: <a href={`mailto:${site.email}`}>{site.email}</a>, <a href={site.phones[0].href}>{site.phones[0].display}</a>.</p>

        <h2>Kontaktni obrazac</h2>
        <p>
          Kada pošaljete upit, obrađujemo podatke koje sami unesete: ime i prezime, naziv firme (ako ga navedete), e-mail
          adresu ili broj telefona, odabranu uslugu, poruku te, ako ga ostavite uključenog, sažetak iz konfiguratora upita.
          Podatke koristimo isključivo da bismo odgovorili na vaš upit i pripremili ponudu.
        </p>
        <p>
          Upit se sa servera stranice šalje e-mailom na adresu agencije putem pružaoca usluge slanja e-pošte (Resend). Poruka
          se ne čuva u bazi podataka na ovoj stranici. Radi zaštite od zloupotrebe, server privremeno i samo u radnoj
          memoriji bilježi IP adresu kako bi ograničio broj uzastopnih slanja.
        </p>

        <h2>Korisni alati</h2>
        <p>
          Vodič, konfigurator i kalkulator rade u vašem pregledniku. Iznosi koje unesete u kalkulator ne šalju se na server,
          ne upisuju se u adresu stranice i ne prosljeđuju se analitici. Sažetak konfiguratora privremeno se čuva u
          pregledniku (sessionStorage) samo dok ga ne prenesete u obrazac, ne uklonite ili ne zatvorite karticu.
        </p>

        <h2>Hosting i tehnički zapisi</h2>
        <p>
          Stranica se poslužuje putem pružaoca usluge hostinga (Vercel), koji radi sigurnosti i rada usluge može bilježiti
          tehničke podatke o zahtjevima, poput IP adrese i vremena pristupa.
        </p>

        <h2>Kolačići i analitika</h2>
        <p>
          Stranica ne postavlja kolačiće za oglašavanje. Ako se uvede alat za mjerenje posjeta, bilježit će se samo
          događaji bez ličnih i finansijskih podataka (npr. da je korišten alat ili poslan upit), a ova politika bit će
          ažurirana prije uvođenja.
        </p>

        <h2>Vanjski linkovi</h2>
        <p>
          Linkovi na Instagram, Facebook, LinkedIn i Google Maps vode na stranice drugih pružalaca, koji imaju vlastita
          pravila o privatnosti. Ti sadržaji se ne učitavaju automatski na ovoj stranici.
        </p>

        <h2>Vaša prava</h2>
        <p>
          Možete zatražiti uvid u podatke koje ste nam poslali, njihov ispravak ili brisanje, tako što ćete nam pisati na
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .meta {
    margin: 0;
    font-size: 0.9rem;
    color: var(--c-ink-muted);
  }
  .prose h2:first-child {
    margin-top: 0;
  }
</style>
