---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { articles, formatDate, type Article } from '../../data/articles.ts';
import { articleSchema, breadcrumbSchema } from '../../lib/schema.ts';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const crumbs = [
  { name: 'Početna', path: '/' },
  { name: 'Savjeti', path: '/savjeti' },
  { name: article.title, path: `/savjeti/${article.slug}` },
];
const more = articles.filter((a) => a.slug !== article.slug);
---

<Base
  title={`${article.title} | Savjeti ACCOUNT`}
  description={article.description}
  ogType="article"
  jsonLd={[articleSchema(article), breadcrumbSchema(crumbs)]}
>
  <article>
    <header class="page-head article-head">
      <div class="container">
        <Breadcrumbs items={crumbs} />
        <h1>{article.title}</h1>
        <p class="lead">{article.description}</p>
        <p class="article-meta">
          Objavljeno <time datetime={article.published}>{formatDate(article.published)}</time>
          {
            article.updated !== article.published && (
              <>
                · ažurirano <time datetime={article.updated}>{formatDate(article.updated)}</time>
              </>
            )
          }
          · {article.readingMinutes} min čitanja
        </p>
      </div>
    </header>

    <div class="container article-layout">
      <div class="prose article-body" set:html={article.body} />

      <aside class="article-related" aria-labelledby="povezano-naslov">
        <h2 id="povezano-naslov">Povezano</h2>
        <ul>
          {
            article.related.map((r) => (
              <li>
                <a class="link-arrow" href={r.href}>
                  {r.label} <Icon name="arrow" size={18} />
                </a>
              </li>
            ))
          }
        </ul>
        <p class="article-disclaimer">
          Tekst je informativan i ne zamjenjuje savjet prilagođen vašem poslovanju.
        </p>
      </aside>
    </div>
  </article>

  <section class="section section--tight" aria-labelledby="jos-naslov">
    <div class="container article-layout">
      <h2 id="jos-naslov" class="more-title">Pročitajte i</h2>
      <ul class="more">
        {
          more.map((a) => (
            <li>
              <a href={`/savjeti/${a.slug}`}>{a.title}</a>
              <p>{a.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .article-head .container,
  .article-layout {
    max-width: calc(46rem + 2 * var(--gutter));
  }
  .article-head h1 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }
  .article-meta {
    margin: 0;
    font-size: 0.9rem;
    color: var(--c-ink-muted);
  }
  .article-body {
    margin-top: clamp(32px, 4vw, 56px);
    font-size: 1.0625rem;
  }
  .article-body :global(h2) {
    margin-top: 1.8em;
  }
  .article-related {
    margin-top: 48px;
    padding: 24px 28px;
    border-radius: var(--radius-lg);
    background: var(--c-bg);
  }
  .article-related h2 {
    font-size: 1.125rem;
  }
  .article-related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .article-disclaimer {
    margin: 20px 0 0;
    font-size: 0.875rem;
    color: var(--c-ink-muted);
  }
  .more-title {
    font-size: 1.375rem;
  }
  .more {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .more a {
    font-weight: 750;
    font-size: 1.125rem;
  }
  .more p {
    margin: 4px 0 0;
    color: var(--c-ink-muted);
    font-size: var(--fs-small);
  }
</style>
